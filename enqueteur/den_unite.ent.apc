{ Application 'den_unite' logic file generated by CSPro }
PROC GLOBAL
string PathProg, PathInput,
		PathPrep, PathInputlogin, PathResources;
file  fileTowrite;
alpha(100) ReadString;
string app="";
string key_cons, new_adresse, type_obs;


PROC FICHE_UNITE_DICT_FF

PROC FICHE_UNITE_LEVEL
preproc
	PathProg = pathname(application);
	PathInputlogin=PathProg + "../input/";
	if !fileexist(PathInputlogin+"Termine_formation.txt") then
		PathInput=PathProg + "../formation/input/";	
	else
		PathInput=PathProg + "../input/";
	endif;

postproc
	if USER_TYPE=2 and EDIF_CODE_CE="" then
		EDIF_NOM_CE=maketext("CE-%s", strip(USER_NAME));
		EDIF_CODE_CE=USER_LOGIN;
	endif;
	
	if UNITE_CONSENTEMENT in 5 then
		UNITE_STATUT=5;
	else
		UNITE_STATUT=4;
	endif;

	// if CONS_STATUT_CONCESSION=1 then
		// if CONS_STATUT=0 then
			// CONS_STATUT=1;
		// endif;
	// else
		// CONS_STATUT=CONS_STATUT_CONCESSION;
	// endif;
	savesetting("Open_menu", "menage");	
PROC FICHE_UNITE_LEVEL_FORM
preproc
	//Définir si le serveur test ou prod
	// savesetting("Open_menu", "cons");
	string version;
	if fileexist(PathInputlogin+"version_enq.txt") then
		setfile(fileTowrite, PathInputlogin+"version_enq.txt");
		if fileread(fileTowrite, ReadString) then
			version=strip(ReadString[1:10]);
		endif;
	endif;
	UNITE_VERSION = version;
	string f_MEN_CODE_AR=getoperatorid();
	if !loadcase(RGE_USERS_DICT, f_MEN_CODE_AR) then
		errmsg("Les informations de l'agent ne sont pas trouvées. Veuillez contacter le niveau cenbtral.");
		// stop(0);
	endif;
	
	// savesetting("Open_menu", "menage");
	key_cons = concat(UNITE_CODESUP, UNITE_ID_DR, UNITE_ID_LACALITE, UNITE_ID_EDIFICE);
	if !loadcase(RGE_FICHE_EDIFICE_DICT, key_cons) then
		errmsg("Impossible de charger la base des localités.");
		// stop(0);
	endif;
	if UNITE_STATUT in 0,notappl then	
		UNITE_DATE=edit("99/99/9999",sysdate("DDMMYYYY"));
		UNITE_NUM_EDIF=EDIF_NUM_EDIF;
		A1=USER_LOGIN+" |"+ strip(USER_NAME);
		A2=WK_LON;
		A3=WK_LAT;
		A4=UNITE_ID_DR[1:2];
		A4A=getlabel(A4, UNITE_ID_DR[1:2]);
		A5=UNITE_ID_DR[1:3];
		A5A=getlabel(A5, UNITE_ID_DR[1:3]);
		A6=UNITE_ID_DR[1:6];
		A6A=getlabel(A6, UNITE_ID_DR[1:6]);
		A7=UNITE_ID_LACALITE;
		A8=EDIF_ZONE_ZC;
		A9=EDIF_MILIEU_RESIDENCE;
		// MEN_REGION=MEN_ID_LACALITE[1:2];
		// MEN_DEPARTEMENT=MEN_ID_LACALITE[1:3];
		// MEN_CVA=MEN_ID_LACALITE[1:6];
		// MEN_COMMUNE=MEN_ID_LACALITE[1:8];
		// MEN_NOM_LOCALITE_FC=QRT_NOM_LOC;	
	endif;
	
	//uuid à remplir une seule fois
	if UNITE_EDIF_UUID="" then
		UNITE_EDIF_UUID=EDIF_UUID;
	endif;
postproc
	if UNITE_STATUT in 0, notappl then
		if UNITE_CONSENTEMENT in 5,7:9 then
			UNITE_STATUT=UNITE_CONSENTEMENT;
		else
			UNITE_STATUT=3;
		endif;
	endif;
	
	//statut cons
	if EDIF_STATUT in 1 then
		EDIF_STATUT=3;
	endif;
	writecase(RGE_FICHE_EDIFICE_DICT);
	
PROC UNITE_CONSENTEMENT
postproc
	new_adresse="";

	if $=9 then
		errmsg("Etes vous sûr que l'enquêté refuse de répondre ? Si vous répondez par oui, l'enquête sera terminée")
		select("Oui, je confirme", continue,
				"Non, revoir la réponse", $);
		new_adresse="";
		type_obs="Observations du refus";	
		errmsg("Confirmez vous une deuxième fois que l'enquêté a refusé de répondre")
		select("Oui, je confirme", FIN_FORM,
				"Non, revoir la réponse", $)
	endif;

	if $ in 7,5 then
		errmsg("Etes vous sûr que l'entité n'a pas été retrouvée ? Si vous répondez par oui, l'enquête sera terminée.")
		select("Oui, je confirme", continue,
				"Non, revoir la réponse", $);
		new_adresse="";
		type_obs="Observations";		
		errmsg("Confirmez vous une deuxième fois que l'entité n'a pas été retrouvée")
		select("Oui, je confirme", FIN_FORM,
				"Non, revoir la réponse", $)
	endif;

	if $=8 then
		errmsg("Etes vous sûr que l'entité a déménagé ? Si vous répondez par oui, l'enquête sera terminée.")
		select("Oui, je confirme", continue,
				"Non, revoir la réponse", $);
				
		new_adresse="Préciser la nouvelle adresse de l'entité."	;
		type_obs="Observations du déménagement (préciser l'adresse actuel si possible)";
		errmsg("Confirmez vous une deuxième fois que l'entité a déménagé.")
		select("Oui, je confirme", FIN_FORM,
				"Non, revoir la réponse", $)
	endif;

	if EDIF_STATUT=0 then
		UNITE_STATUT=$;
	endif;
PROC A11
postproc
	if $<>999999999 then
		if ! regexmatch(maketext("%d",$), "^(71|77|76|75|78|70|33|30)[0-9]{7}$") then
			// 
			errmsg("Le numéro indiqué n'est pas correct");
			reenter;
		endif;
	endif;
	
	if $=777777777 then
		errmsg("Veuillez indiquer le numéro de téléphone.");
		reenter;
	endif;
PROC A12
postproc
	if $<>999999999 then
		if ! regexmatch(maketext("%d",$), "^(71|77|76|75|78|70|33|30)[0-9]{7}$") then
			// 
			errmsg("Le numéro indiqué n'est pas correct");
			reenter;
		endif;
	endif;
	
	if $=777777777 then
		errmsg("Veuillez indiquer le numéro de téléphone.");
		reenter;
	endif;
PROC A14A
	A15A=getvaluelabel($);
PROC A14B
preproc
	valueset string citi = A14B_VS1;
	list string citi_codes = A14B_VS1.codes;
	
	do numeric i=1 while i<=citi_codes.length()
		if citi_codes(i)[1:2]<>A14A then
			citi.remove(citi_codes(i));
		endif;
	enddo;
	setvalueset($, citi);

postproc
	A15B=getvaluelabel($);
PROC BLOCK001
	if length(strip(A16))<3 or length(strip(A17))<3 then
		errmsg("Veuillez entrer un nom et un prénom valide");
		reenter A16;
	endif;
PROC BLOCK002
	if length(strip(A18))<3 or length(strip(A19))<3 then
		errmsg("Veuillez entrer un nom et un prénom valide");
		reenter A18;
	endif;
