///fonction connexion

function backup()
	errmsg("Backup en construction... Vous pouvez poursuivre.");
	exit 1;
end;

function clear_parameters_test()
	// string public_key= "KATAKURI";
	// if  LOGIN_ENQ[1:4]<>'0999' and fileexist(PathInputlogin+"Termine_formation.txt") then
		// errmsg("Vous ne pouvez pas réinitialiser l'application de collecte. Veuillez contacter le niveau central.");
		// exit 0;
	// endif;
	string public_key= "CARTO"; 
	string password_admin = prompt("Entrez le mot de passe administrateur", Uppercase);
	if not password_admin = public_key then
		errmsg("Le mot de passe est incorrect.");
		exit 0;
	endif;
	filedelete(PathInputlogin+"Initialize.txt");
	filedelete(PathInputlogin+"Termine_formation.txt");
	filedelete(PathInputlogin+"login_*.csdb");
	filedelete(PathParam+"login_*.txt");
	filedelete(PathParam+"Initialize_*.txt");
	// filedelete(PathInput+"geojson/*.geojson");
	// filedelete(PathInput+"geojson_temp/*.geojson");
	
	errmsg("Tablette réinitialisée avec succès.");
	stop(0);
end;

function clear_parameters()
	// if admin_acces(LOGIN_ENQ, 1) =0 then
		// exit;
	// endif;
	string public_key= "CARTO"; 
	string password_admin = prompt("Entrez le mot de passe administrateur", Uppercase);
	if not password_admin = public_key then
		errmsg("Le mot de passe est incorrect.");
		exit 0;
	endif;
	
	filedelete(PathInputlogin+"Initialize.txt");
	filedelete(PathInputlogin+"login_*.csdb");
	filedelete(PathParam+"Initialize_*.txt");
	errmsg("Tablette réinitialisée avec succès.");
	stop(1);
end;

function change_app_coll()
	if !fileexist(PathInputlogin+"Initialize.txt") then
		errmsg("Vous ne pouvez pas passer en mode collecte tant que vous n'avez pas initialisé votre application.");
		exit;
	endif;
	if app='test' then
		if admin_acces(LOGIN_ENQ, 10) =0 then
			exit;
		endif;
	else
		if admin_acces(LOGIN_ENQ, 2) =0 then
			exit;
		endif;
	endif;
	//Verif si l'agent à déjà sync les données du test
	string login_form;
	setfile(fileTowrite, PathInputlogin+"Initialize.txt");
	if fileread(fileTowrite, ReadString) then
		login_form=strip(ReadString[1:7]);
	endif;
	// if fileexist(PathInput + "login_"+login_form+".csdb") then
		// setfile(RGE_USERS_DICT, PathInput + "login_"+login_form+".csdb");
	// else
		// setfile(RGE_USERS_DICT, PathInput + "login_"+login_form+".csdb", create);
	// endif;
	
	loadcase(RGE_USERS_DICT, login_form);
	// if SYNC_CONTROLE_COUNT<>1 then
		// errmsg("Veuillez synchroniser les données de test avant de passer à l'application de l'Agent Enquêteur.");
		// exit;
	// endif;
	//Recup nouveaux statuts
	if connect_to_serveur("serveur_input", app)=0 then
		reenter;
	endif;
	setfile(RGE_USERS_DICT, PathInputlogin + "login_"+login_form+".csdb", create);
	if !syncdata(GET, RGE_USERS_DICT, login_form) then
		errmsg("Le nouveau statut de l'agent n'est pas récupéré.");
		exit 0;
	endif;
	loadcase(RGE_USERS_DICT, login_form);
	if USER_TYPE<>1 then
		errmsg("Cette application est réservée uniquement aux enquêteurs. Veuillez contacter votre chef d'équipe.");
		exit 0;
	endif;
	//finaliser
	// if backup()=0 then
		// exit;
	// endif;
	// close(fileTowrite);
	setfile(fileTowrite, PathInputlogin+"Termine_formation.txt", create);
	filewrite(fileTowrite,sysdate("YYYYMMDD"));
	close(fileTowrite);
	
	// // filedelete(PathInput+"formation.txt");
	// filedelete(PathData+"menages_*.csdb");
	// // filedelete(PathInput+"Initialize.txt");
	// // filedelete(PathParam+"Initialize_*.txt");
	// filedelete(PathInput+"echantillon_*.csdb");
	// filedelete(PathInput+"quartier_*.csdb");
	// // filedelete(PathInput+"login_*.csdb");
	// filedelete(PathData+"test_*.csdb");
	errmsg("L'application de l'Agent Enqueteur est installée avec succès. Cliquer sur OK pour la réouvrir puis de vous approcher de votre chef d'équipe pour initialisation.");
	stop(1);
end;

function clear_setting()
	if admin_acces(LOGIN_ENQ, 2) =0 then
		exit;
	endif;
	savesetting(clear);
	errmsg("Tablette réinitialisée.");
	reenter;
end;

//terminer le test automatiquement
function  automatique_termine_test()
end;


function update_agent_serveur()
	numeric choice=0;
	choice = accept("Cette option est utilisée si vous n'arrivez pas synchroniser correctement avec votre chef d'équipe. Etes-vous sûr de vouloir continuer ?",
						"Oui", "Non");
	if choice<>1 then
		exit;
	endif;
	
	if admin_acces(LOGIN_ENQ, 20) =0 then
		exit;
	endif;
	string login_current;
	if fileexist(PathInput+"Initialize.txt") then
		setfile(fileTowrite, PathInput+"Initialize.txt");
		if fileread(fileTowrite, ReadString) then
			login_current=strip(ReadString[1:7]);
		endif;
	endif;	
	if fileexist(PathInputlogin + "login_"+login_current+".csdb") then
		setfile(RGE_USERS_DICT, PathInputlogin + "login_"+login_current+".csdb");
	else
		setfile(RGE_USERS_DICT, PathInputlogin + "login_"+login_current+".csdb", create);
	endif;
	if connect_to_serveur("serveur_input", app)=0 then
		exit 0;
	endif;
	close(RGE_USERS_DICT);
	// filedelete(PathParam + 'login_' + ID_ACTOR + '.csdb');
	if !filecopy(PathInputlogin + 'login_' + login_current + '.csdb', PathParam + 'login_' + login_current + '.csdb') then
		errmsg("Les informations de l'agent  ne sont pas copiées. Veuillez contacter le niveau central.");
		exit 0;
	endif;
	numeric i=0;
	CLOSE(RGE_USERS_DICT);
	filedelete(PathInputlogin + 'login_' + login_current + '.csdb');
	setfile(RGE_USERS_DICT, PathInputlogin + 'login_' + login_current + '.csdb', create);
	if  !syncdata(GET, RGE_USERS_DICT, login_current) then
		inc(i);
	endif;
	
	if !loadcase(RGE_USERS_DICT, login_current) then
		// filecopy(PathParam+ 'login_' + ID_ACTOR + '.csdb', PathInput  + 'login_' + ID_ACTOR + '.csdb');
		inc(i);		
	endif;
	if i=0 then
		loadcase(RGE_USERS_DICT, login_current);
		LUNCH_AUTHORIZED=1;
		writecase(RGE_USERS_DICT);
		errmsg("Les informations de l'enquêteur sonbt actualisées avec succés.");
		exit 1;
	else
		filecopy(PathParam+ 'login_' + login_current + '.csdb', PathInput  + 'login_' + login_current + '.csdb');
		errmsg("L'opération ne s'est pas bien passé.");
		exit 0;
	endif;
end;

function change_compte()
	numeric choice=0;
	choice = accept("Cette option est utilisée lorsque l'agent veut changer de compte pour appui. Les données du compte changé ne seront pas supprimées. Etes-vous sûr de vouloir continuer ?",
						"Oui", "Non");
	if choice<>1 then
		exit;
	endif;
	
	if admin_acces(LOGIN_ENQ, 26) =0 then
		exit;
	endif;
	
	filedelete(PathInput+"Initialize.txt");
	
	errmsg("Le compte a été réinitialisée avec succès.");
	stop(1);
end;


function backup_central_urgence(numeric ctr,string xapp, string login)
	if length(login)<>7 then
		errmsg("Aucun compte actif. Veillez activer un compte avant d'utiliser cette option.");
		exit 0;
	endif;
	numeric choice=0;
	choice = accept("Cette option est utilisée pour envoyer un backup vers le serveur. Etes-vous sûr de vouloir continuer ?",
							"Oui", "Non");
	if choice<>1 then
		exit 0;
	endif;
	if admin_acces(LOGIN_ENQ, 200) =0 then
			exit 0;
		endif;
	list string filelisting;
	
	 // InputPath = pathname(application) + "../input/";
	 // InitPath= pathname(application) + "../init/";
	 // TempPapth= pathname(application) + "../temp/";
	 //Pathcomp= pathname(application) + "../comp/";
	//fermer l'ensemble des fichiers 
	CLOSE(RGE_USERS_DICT);
	// CLOSE(CARTO_DR_DICT);
	CLOSE(fileTowrite);
	filelisting.clear();
	dirlist(filelisting, PathInput, recursive); 
	compress(PathTemp+"input.zip",filelisting);
	filelisting.clear();
	dirlist(filelisting, PathData, recursive); 
	compress(PathTemp+"data.zip",filelisting);
	filelisting.clear();
	dirlist(filelisting, PathParam, recursive); 
	compress(PathTemp+"param.zip",filelisting);
	filelisting.clear();
	filelisting.add(PathTemp+"param.zip");
	filelisting.add(PathTemp+"data.zip");
	filelisting.add(PathTemp+"input.zip");
	//Historisation
	if ctr=1 then
		compressed_file="backup_CE_" + login + "_" +timestring("%Y-%m-%d", timestamp())+".zip";
	else
		// compressed_file="backup_AR_" + login + "_" +timestring("%Y-%m-%d_%H-%M", timestamp())+".zip";
		compressed_file="backup_AR_" + login + "_" +timestring("%Y-%m-%d", timestamp())+".zip";
	endif;
	compress(PathTemp+compressed_file, filelisting);
	//dernière
	// string pathbackup_1 = pathname(CsentryExternal);
	// if direxist(pathname(CsentryExternal)) then 
		// if ! filecopy(compressed_file, pathname(CsentryExternal)) then 
				// errmsg("Une erreur a été rencontrée lors du backup local");
		// endif;
	// endif;	
	// filecopy(compressed_file, pathname(Downloads)); 
	
	//Synchronisation
	if connect_to_serveur("serveur_input", xapp)=0 then
		exit 0;
	endif;
	numeric i=0;
	if !syncfile(PUT, "../temp/"+compressed_file, "/rnu/backup/") then
		inc(i);
	endif;
	
	syncdisconnect();
	if i=0 then
		errmsg("Opération réussie.");
	else
		errmsg("L'opération a échouée.");
	endif;
end;

function recup_backup_central_urgence(numeric ctr,string xapp, string login)
	if length(login)>0 then
		errmsg("Vous ne pouvez pas utilise cette option si vous avez un compte actif.");
		exit 0;
	endif;
	numeric choice=0;
	choice = accept("Cette option est utilisée pour récupérer un backup serveur. Etes-vous sûr de vouloir continuer ?",
							"Oui", "Non");
	if choice<>1 then
		exit 0;
	endif;
	
	if admin_acces(LOGIN_ENQ, 300) =0 then
		exit 0;
	endif;
	
	//Login
	string login2 = prompt("Entrer votre login : ", Uppercase);
	if length(login2)<>7 then
		errmsg("Login non valide.");
		exit 0;
	endif;
	//Historisation
	if ctr=1 then
		compressed_file="backup_CE_" + login2 + "_*.zip";
	else
		// compressed_file="backup_AR_" + login2 + "_" +timestring("%Y-%m-%d_%H-%M", timestamp())+".zip";
		compressed_file="backup_AR_" + login2 + "_*.zip";
	endif;
	
	//Synchronisation
	if connect_to_serveur("serveur_data", xapp)=0 then
		exit 0;
	endif;
	numeric i=0;
	CLOSE(RGE_USERS_DICT);
	// CLOSE(CARTO_DR_DICT);
	CLOSE(fileTowrite);
	
	if !syncfile(GET, "/rnu/backup/"+ compressed_file, "backup_CE_" + login2 + ".zip") then
		errmsg("Le backup urgence n'est pas retrouvé.");
		inc(i);
	endif;
	syncdisconnect();
	
	// dircreate(PathProg+"input");
	// dircreate(PathProg+"data");
	// dircreate(PathProg+"param");
	if decompress(PathProg+ "backup_CE_" + login2 + ".zip")=default then
		errmsg("decompress non valide.");
		inc(i);
	endif;
	if decompress(PathProg+ "input.zip", "../input")=default then
		errmsg("decompress input non valide.");
		inc(i);
	endif;
	if decompress(PathProg+ "data.zip", "../data")=default then
		errmsg("decompress data non valide.");
		inc(i);
	endif;
	if decompress(PathProg+ "param.zip", "../param")=default then
		errmsg("decompress param non valide.");
		inc(i);
	endif;
	if i=0 then
		// filecopy(PathProg+ "input", "../input/");
		// filecopy(PathProg+ "data", "./data/");
		// filecopy(PathProg+ "param", "/param/");
		errmsg("Opération réussie.");
	else
		errmsg("L'opération a échouée.");
	endif;
	
end;


function dossier_create()
	//Dossiers de formation
	if !direxist(PathProg+"../formation") then
		dircreate(PathProg+"../formation");
	endif;
	if !direxist(PathProg+"../formation/input") then
		dircreate(PathProg+"../formation/input");
	endif;
	if !direxist(PathProg+"../formation/input/geojson") then
		dircreate(PathProg+"../formation/input/geojson");
	endif;
	if !direxist(PathProg+"../formation/tpk") then
		dircreate(PathProg+"../formation/tpk");
	endif;
	if !direxist(PathProg+"../formation/data") then
		dircreate(PathProg+"../formation/data");
	endif;
	
	//
	if !direxist(PathInput) then
		dircreate(PathInput);
	endif;
	if !direxist(PathInput+ "geojson") then
		dircreate(PathInput+ "geojson");
	endif;
	if !direxist(PathData) then
		dircreate(PathData);
	endif;
	if !direxist(PathTpk) then
		dircreate(PathTpk);
	endif;
	if !direxist(PathParam) then
		dircreate(PathParam);
	endif;

	// if !direxist(PathBackup) then
		// dircreate(PathBackup);
	// endif;
	if !direxist(PathTemp) then
		dircreate(PathTemp);
	endif;
	// if !direxist(PathDataSuivi) then
		// dircreate(PathDataSuivi);
	// endif;
end;

PROC LOGIN_ENQ_FF

PROC AUTHENTIFICATION_ENQ_LEVEL
preproc
	PathProg=pathname(Application);
	PathParam=PathProg + "../param/";
	PathTemp=PathProg + "../temp/";
	PathInputlogin=PathProg + "../input/";
	if !fileexist(PathInputlogin+"Termine_formation.txt") then
		PathInput=PathProg + "../formation/input/";
		PathData=PathProg +  "../formation/data/";
		PathTpk=PathProg +   "../formation/tpk/";
	else
		PathInput=PathProg + "../input/";
		PathData=PathProg +  "../data/";
		PathTpk=PathProg +   "../tpk/";
	endif;
	//Définir si le serveur test ou prod
	if fileexist(PathInputlogin+"app.txt") then
		setfile(fileTowrite, PathInputlogin+"app.txt");
		if fileread(fileTowrite, ReadString) then
			app=strip(ReadString[1:10]);
		endif;
	endif;
	
	if fileexist(PathInputlogin+"Initialize.txt") then
		setfile(fileTowrite, PathInputlogin+"Initialize.txt");
		if fileread(fileTowrite, ReadString) then
			nom_enq_ini=strip(ReadString[1:50]);
			login_curr = strip(ReadString[1:7]);
			savesetting("Nom_enqueteur", strip(ReadString[1:50]));
		endif;
	endif;
	
	// filedelete(PathInput+"formation.txt");
	if app="test" then
		if !fileexist(PathInput+"Termine_formation.txt") then
			userbar(clear);
			userbar(add button,"Passer en mode collecte ", change_app_coll());
			userbar(add button,"Réinitialisée l'application de formation (Test)", clear_parameters_test());
			userbar(add button,"Afficher le manuel AR ", view_manual_app(PathInputlogin, "AR"));
			userbar(Show);
		else
			userbar(clear);
			userbar(add button,"Réinitialisée l'application de test ", clear_parameters_test());
			userbar(add button,"Réinitialisée l'application pour appui", clear_parameters());
			// userbar(add button,"Réinitialisée l'application (Test)", clear_parameters_test());
			// userbar(add button,"Actualiser mes informations personnelles ", update_agent_serveur());
			// userbar(add button,"Changement de compte pour appui ", change_compte());
			// userbar(add button,"Envoi backup d'urgence au niveau central", backup_central_urgence(2, app, login_curr));
			// userbar(add button,"Récupération du backup d'urgence", recup_backup_central_urgence(2, app, login_curr));
			userbar(add button,"Afficher le manuel AR ", view_manual_app(PathInputlogin, "AR"));
			userbar(Show);
		endif;
	
	else
		if !fileexist(PathInput+"Termine_formation.txt") then
			userbar(clear);
			userbar(add button,"Passer en mode collecte ", change_app_coll());
			// userbar(add button,"Réinitialisée l'application de formation", clear_parameters());
			userbar(add button,"Réinitialisée l'application de formation ", clear_parameters_test());
			userbar(add button,"Afficher le manuel AR ", view_manual_app(PathInputlogin, "AR"));
			userbar(Show);
		else
			userbar(clear);
			userbar(add button,"Réinitialisée l'application pour appui", clear_parameters());
			// userbar(add button,"Réinitialisée l'application (Test)", clear_parameters_test());
			// userbar(add button,"Actualiser mes informations personnelles ", update_agent_serveur());
			// userbar(add button,"Changement de compte pour appui ", change_compte());
			// userbar(add button,"Envoi backup d'urgence au niveau central", backup_central_urgence(2, app, login_curr));
			// userbar(add button,"Récupération du backup d'urgence", recup_backup_central_urgence(2, app, login_curr));
			userbar(add button,"Afficher le manuel AR ", view_manual_app(PathInputlogin, "AR"));
			userbar(Show);
		endif;
	endif;

	dossier_create();
	savesetting(clear);
PROC IDS0_FORM
preproc
	// published = edit("99-99-99 at 99:99:99", publishdate());
	published = edit("9999-99-99", int(publishdate() / 1000000) ); // ignore the time 
	savesetting(clear);
	
	if app="test" then
		// if datediff(int(publishdate() / 1000000),sysdate("YYYYMMDD")) > 30 then 
			// errmsg("Cette application a expiré. Elle était destinée uniquement pour la formation des chefs d'équipe."); 
			// stop(1); 
		// endif;
	endif;
	
	savesetting("Open_menu", "no");
PROC LOGIN_ENQ
preproc
	if fileexist(PathInputlogin+"Initialize.txt") then
		setfile(fileTowrite, PathInputlogin+"Initialize.txt");
		if fileread(fileTowrite, ReadString) then
			nom_enq_ini=strip(ReadString[1:50]);
			savesetting("Nom_enqueteur", strip(ReadString[1:50]));
		endif;
	endif;
	if fileexist(PathInputlogin+"version_enq.txt") then
		setfile(fileTowrite, PathInputlogin+"version_enq.txt");
		if fileread(fileTowrite, ReadString) then
			versiong=strip(ReadString[1:5]);
		endif;
	endif;
	
	//Définir le type d'application
	string date_fin_formation;
	if !fileexist(PathInputlogin+"Termine_formation.txt") then
		setfile(fileTowrite, PathInputlogin+"formation.txt");
		if fileread(fileTowrite, ReadString) then
			date_fin_formation=strip(ReadString[1:8]);
		endif;
		
		date_diff = datediff(sysdate("YYYYMMDD"), tonumber(date_fin_formation),"d");
		// errmsg("date_formation : %d; date_diff = %d", tonumber(date_fin_formation), date_diff);
		if date_diff<=0 then
			// errmsg("Ceci est une application de formation. Elle est expirée depuis le %s. Contacter votre formateur pour accéder à l'application de la collecte RNU.", edit("9999-99-99", tonumber(date_fin_formation)));
			// stop(0);
		endif;
		app_current="formation";
		savesetting("formation", "yes");
		app_name="Application de formation de l'Agent cartographe";
	else
		app_name="Application de Collecte de l'Agent cartographe";
	endif;
	
postproc		
	if app='test' and LOGIN_ENQ[1:4]<>'0999' then
		errmsg("Cette application de Enquêteur est réservée pour la formation des chefs d'équipe. Contacter le niveau central pour avoir les accés.");
		reenter;
	endif;
	
	//vérifie si la tablette n'a pas été utilisée par un autre agent
	string login_current;
	if fileexist(PathInputlogin+"Initialize.txt") then
		setfile(fileTowrite, PathInputlogin+"Initialize.txt");
		if fileread(fileTowrite, ReadString) then
			login_current=strip(ReadString[1:7]);
		endif;
		if login_current<>$ then	
			errmsg("La tablette n'a pas été initialisée avec le login %s", $);
			reenter;
		endif;
	endif;

	string Password = prompt("Indiquez votre mot de passe :",Uppercase);
	if length(Password)<4 then
		errmsg("Un mot de passe doit être composé de quatre caractères. Veuillez réessayer.");
		reenter;
	endif;
	
	//Ouverture
	if fileexist(PathInputlogin+"Initialize.txt") then
		if fileexist(PathInputlogin + 'login_' + $ + '.csdb') then
			setfile(RGE_USERS_DICT, PathInputlogin + 'login_' + $ + '.csdb');
		else
			errmsg("Les informations de l'enquêteur ne sont pas trouvées. Veuillez contacter le niveau central.");
			reenter;
		endif;
		if loadcase(RGE_USERS_DICT, $) then
			if USER_PASS<>tonumber(Password) then
				errmsg("Cette tablette n'est pas la votre.");
				reenter;
			endif;
		else
			errmsg("Les informations de l'enquêteur ne sont pas trouvées. Veuillez contacter le niveau cental.");
			reenter;
		endif;
		//Ouverture du menu
		menuPff(LOGIN_ENQ, 
						"den_menu_enq", "den_login_enq", "Application de l'Agent Enquêteur",
						PathProg, PathInput, PathInputlogin);
	endif;
	
	//Ouverture pour la première fois
	assignment_universe = "TAB"+LOGIN_ENQ;
	if app_current="formation" then
		//* APPLICATION DE LA FORMATION *//
		numeric choice=0;
		choice=accept("Ceci est une application de formation. Récupération des données de  "+ $+ " | " +Password+". Confimez vous que ces informations sont correctes",
						"Oui je confirme, continuer.",
						"Corriger le login ou le mot de passe.");
		if choice in 1 then 						
			errmsg("L'application va procéder à la récupération des données de l'enquêteur %s depuis le serveur csweb. Cliquer sur OK pour continuer", $);
		else
			reenter;
		endif;
		if connect_to_serveur("serveur_input", app)=0 then
			reenter;
		endif;
		CLOSE(RGE_USERS_DICT);
		// CLOSE(CARTO_DR_DICT);
		// CLOSE(CARTO_ECHANTILLON_DICT);
		setfile(RGE_USERS_DICT, PathTemp + 'login_' + $ + '.csdb', create);
		// setfile(CARTO_DR_DICT, PathTemp+ "dr_"+$+".csdb", create);
		// setfile(CARTO_ECHANTILLON_DICT, PathTemp + 'echantillon_' + $ + '.csdb', create);
		
		if  !syncdata(GET, RGE_USERS_DICT, $) then
			errmsg("L'agent indiqué n'a pas été trouvé. Veuillez indiquer l'identifiant correct ou contacter le niveau central.");
			syncdisconnect();
			reenter;
		endif;
		if !loadcase(RGE_USERS_DICT, $) then
			errmsg("Le login %s n'est pas retrouvé.", $);
			syncdisconnect();
			reenter;
		endif;
		
		if USER_PASS<>tonumber(Password) then
			errmsg("Le mot de passe que vous avez mis est incorrect. Veuillez réessayer à nouveau.");
			reenter;
		endif;
		if not USER_TYPE in 0,1 then
			errmsg("Cette application est réservée aux enquêteurs.");
			reenter;
		endif;
		
		//Finalisation de l'opération
		if !filecopy(PathTemp + 'login_' + $ + '.csdb', PathInputlogin + 'login_' + $ + '.csdb') then
			reenter;
		endif;
		
		CLOSE(RGE_USERS_DICT);
		if !setfile(RGE_USERS_DICT, PathInputlogin + 'login_' + $ + '.csdb') then
			reenter;
		endif;
		{
		CLOSE(CARTO_DR_DICT);
		if !setfile(CARTO_DR_DICT, PathInput+ 'dr_'+$+'.csdb') then
			reenter;
		endif;
		CLOSE(CARTO_ECHANTILLON_DICT);
		if !setfile(CARTO_ECHANTILLON_DICT, PathInput + 'echantillon_' + $ + '.csdb') then
			reenter;
		endif;
		}
	else
		//* APPLICATION DE LA COLLECTE : Pour ceux qui ont désinstallé l'application*//
		
		if connect_to_serveur("serveur_input", app)=0 then
			reenter;
		endif;
		CLOSE(RGE_USERS_DICT);
		setfile(RGE_USERS_DICT, PathTemp + 'login_' + $ + '.csdb', create);
		
		if  !syncdata(GET, RGE_USERS_DICT, $) then
			errmsg("L'agent indiqué n'a pas été trouvé. Veuillez indiquer l'identifiant correct ou contacter le niveau central.");
			syncdisconnect();
			reenter;
		endif;
		if !loadcase(RGE_USERS_DICT, $) then
			errmsg("Le logine %s n'est pas retrouvé.", $);
			syncdisconnect();
			reenter;
		endif;
		
		if USER_PASS<>tonumber(Password) then
			errmsg("Le mot de passe que vous avez mis est incorrect. Veuillez réessayer à nouveau.");
			reenter;
		endif;
		if USER_TYPE<>1 then
			errmsg("Cette application est réservé aux enquêteurs. Veuillez assurer que le formateur a fini le profilage.");
			reenter;
		endif;
		
		//Finalisation de l'opération
		if !filecopy(PathTemp + 'login_' + $ + '.csdb', PathInputlogin + 'login_' + $ + '.csdb') then
			reenter;
		endif;
		CLOSE(RGE_USERS_DICT);
		setfile(RGE_USERS_DICT, PathInputlogin + 'login_' + $ + '.csdb');
	endif;
	
	loadcase(RGE_USERS_DICT, LOGIN_ENQ);
	string name_text= USER_LOGIN+"|"+strip(USER_NAME);
	setfile(fileTowrite, PathParam+"Initialize_"+maketext("%06s",LOGIN_ENQ)+".txt", create);
	filewrite(fileTowrite,name_text);
	close(fileTowrite);
	//copy
	filecopy(PathParam+"Initialize_"+maketext("%06s",LOGIN_ENQ)+".txt", PathInputlogin+"Initialize.txt");
	errmsg("Données récupérer avec succès");
	// Ouverture du menu
	menuPff(LOGIN_ENQ, 
					"den_menu_enq","den_login_enq", "Application de l'Agent Enquêteur",
					PathProg, PathInput, PathInputlogin);
	reenter;
