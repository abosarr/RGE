function recup_quartier_bluetooth(string login_user)
	init_dictionaries(1);
	numeric nb = countcases(RGE_FICHE_QUARTIER_DICT(startswith, CODE_FORMATEUR));
	if nb>0 then
		errmsg("La liste des quartiers est déjà récupée. Voulez vous la récupérer à nouveau ?")
		select("Oui", continue, "Non", reenter);
	endif;
	// setbluetoothname(maketext("TAB%s", login_user));
	// //Recup quartier et user avec le type agent enqueteur
	// numeric i=0;
	// if !syncserver(Bluetooth) then
		// errmsg("La connextion avec le chef d'équipe ne s'est pas bien établie. Veuillez réesayer.");
		// inc(i);
		// syncdisconnect();
		// exit 0;
	// endif;
	// syncdisconnect();
	// if countcases(RGE_FICHE_QUARTIER_DICT)>0 and i=0 then
		// errmsg("Les données des communes et quartiers sont récupérées avec succès.");
		// exit 1;
	// else
		// errmsg("L'opération a échouée.");
		// exit 0;
	// endif;
	
	server_name = maketext("TAB%s", ID_ACTOR);
	if syncconnect(bluetooth, server_name) then 
		if  !syncdata(GET, RGE_FICHE_QUARTIER_DICT, CODE_FORMATEUR) then
			errmsg("Les quartiers ne sont pas reçus.");
			syncdisconnect();
			exit 0;
		endif;
	else
		errmsg("Impossible de se connecté avec le chef d'équipe %s", CODE_CE);
		syncdisconnect();
		exit 0;
	endif;
	syncdisconnect();
	errmsg("La données des communes des quartiers récupérées avec succès.");
end;

