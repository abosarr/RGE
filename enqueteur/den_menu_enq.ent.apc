function init_dictionaries(numeric type)
	close(RGE_USERS_DICT);
	if fileexist(PathInputlogin + 'login_' + ID_ACTOR + '.csdb') then
		setfile(RGE_USERS_DICT, PathInputlogin + 'login_' + ID_ACTOR + '.csdb');
	else
		errmsg("Les information de l'enquêteur ne sont pas trouvées.");
		exit 0;
	endif;
	close(RGE_FICHE_QUARTIER_DICT);
	if fileexist(PathInput + 'quartiers_' + ID_ACTOR + '.csdb') then
		setfile(RGE_FICHE_QUARTIER_DICT, PathInput + 'quartiers_' + ID_ACTOR + '.csdb');
	else
		setfile(RGE_FICHE_QUARTIER_DICT, PathInput + 'quartiers_' + ID_ACTOR + '.csdb',create);
	endif;
	close(RGE_FICHE_EDIFICE_DICT);
	if fileexist(PathInput+ "concessions_"+ID_ACTOR+".csdb") then
		setfile(RGE_FICHE_EDIFICE_DICT, PathInput+ "concessions_"+ID_ACTOR+".csdb");
	else
		setfile(RGE_FICHE_EDIFICE_DICT, PathInput+ "concessions_"+ID_ACTOR+".csdb", create);
	endif;
	close(RGE_FICHE_UNITE_DICT);
	if fileexist(PathInput+ "menages_"+ID_ACTOR+".csdb") then
		setfile(RGE_FICHE_UNITE_DICT, PathInput+ "menages_"+ID_ACTOR+".csdb");
	else
		setfile(RGE_FICHE_UNITE_DICT, PathInput+ "menages_"+ID_ACTOR+".csdb", create);
	endif;
end;


function open_menage_function(numeric ctr)
	string id_men_current = list_menage(ctr);
	string id_quart_current = list_menage(ctr)[1:32];
	//Pour le cas des structures supprimées
	loadcase(RGE_FICHE_UNITE_DICT, id_men_current);
	if UNITE_AJOUT=6 then
		exit 0;
	endif;
	string men_ncm=strip(UNITE_NOM_UNITE);
	clear(RGE_FICHE_UNITE_DICT);
	open_menage_pff(id_men_current, ID_ACTOR, 
				PathProg, PathData, PathInput, PathInputlogin,"den_menu_enq", men_ncm, 'AR');
end;

