	//**************************************************************//

{
function ValidatedMerge(map m, numeric markerIDNew, numeric lat,  numeric lon, numeric xdistanceMaxAllowed, string ctr)
	// if VerifyDistance_ensemble(m, markerIDNew, selectedMarkersListID, lat, lon, xdistanceMaxAllowed, ctr)= 0 then
		// if app_current="formation" then
			// errmsg("Appuyer sur Ok pour continuer seulement lors de la formation");
		// else
			// exit 0;
		// endif;
	// endif;
	//mise à jour de la table attributaire des points disparus
	// numeric markerId
	numeric j;
	// Numeric NewNum=GenNum();
	string new_EDIF_ID_EDIFICE=maketext("N%04s",uuid()[1:4]);
	string key_cons_fusion;
	do varying j=1 while j<=selectedMarkersListID.length()
		string key_cons_current=selectedMarkersList(j);
		loadcase(RGE_FICHE_EDIFICE_DICT, key_cons_current);
		EDIF_ID_PARENT=key_cons_current[1:20]+new_EDIF_ID_EDIFICE; //cste
		EDIF_AJOUT=20;
		EDIF_STATUT=51;
		writecase(RGE_FICHE_EDIFICE_DICT);
		key_cons_fusion=key_cons_fusion+key_cons_current;
	enddo;
	//Mise à jour du nouveau point.  
	new_cons_validation(m, markerIDNew, lat, lon, xdistanceMaxAllowed,2,2, new_CONS_ID_EDIFICE, key_cons_fusion);
end;

function ValidatedSeparate(map m, numeric markerIDNew, numeric lat,  numeric lon, numeric xdistanceMaxAllowed, string ctr)
	string dr=loadsetting("key_dr_current", "no");
	string qrt=loadsetting("key_quartier_current", "no");
	// string nb_newcons = prompt("Indiquez le nombre de concession issue de la concession scindée (y compris la concession scindée) :", Numeric);
	// if tonumber(nb_newcons)<2 then
		// errmsg("Une concession scindée doit devenir au moins deux concessions.");
		// exit 0;
	// elseif nb_newcons="" then
		// exit 0;
	// endif;
	forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt) do
		if selectedMarkersList.seek(key(RGE_FICHE_EDIFICE_DICT))>0 then
			CONS_AJOUT=30;
			writecase(RGE_FICHE_EDIFICE_DICT)
		endif;
	enddo;
	string new_CONS_ID_EDIFICE=maketext("N%04s",uuid()[1:4]);
	string key_cons_scinde=selectedMarkersList(1);
	new_cons_validation(m, markerIDNew, lat, lon, xdistanceMaxAllowed,3,2, new_CONS_ID_EDIFICE, key_cons_scinde);
	forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt) do
		if selectedMarkersList.seek(key(RGE_FICHE_EDIFICE_DICT))>0 then 
			CONS_AJOUT=0;
			writecase(RGE_FICHE_EDIFICE_DICT)
		endif;
	enddo;
	
end;

function ValidatedMergeSeparate(map m, numeric markerIDNew, numeric lat,  numeric lon, numeric xdistanceMaxAllowed, string ctr)
	if VerifyDistance_ensemble(m, markerIDNew, selectedMarkersListID, lat, lon, xdistanceMaxAllowed, ctr)= 0 then
		if app_current="formation" then
			errmsg("Appuyer sur Ok pour continuer seulement lors de la formation");
		else
			exit 0;
		endif;
	endif;
	if ctr="merge" then
		ValidatedMerge(m,  markerIDNew,  lat,   lon,  xdistanceMaxAllowed, ctr);
	elseif ctr="separate" then
		ValidatedSeparate(m, markerIDNew, lat,  lon, xdistanceMaxAllowed, ctr);
	endif;

end;

function RelocatePoint(map m, string xresources, numeric xdistanceMaxAllowed, string ctr)
	savesetting("valid_click", "no");
	numeric markerid;
	if ctr="merge" then
		if selectedMarkersList.length()<2 then
			errmsg("Vous devez choisir au moins deux concessions");
			exit 0;
		endif;
	elseif ctr="separate" then
		if selectedMarkersList.length()=0 then
			errmsg("Vous devez choisir la concession à scinder.");
			exit 0;
		elseif selectedMarkersList.length()>1 then
			errmsg("Vous devez choisir une seule concession pour cette opération.");
			exit 0;
		endif;
	else
		exit 0;
	endif;
	
	// if selectedMarkersList.length()<2 then
		// errmsg("Vous devez choisir au moins deux concessions");
		// exit 0;
	// endif;
	gps(open);
	if gps(read,10) then  
	else
		errmsg("Signal GPS non capté. Vérifier si votre GPS fonctionne correctement");
		exit;
	endif;

	gps(close);
	numeric Lat= gps(latitude);
	numeric lon=gps(longitude);
	markerId = m.addMarker(lat, lon);
	m.setMarkerImage(markerId, xresources+"add-location.png");
	m.zoomTo(lat, lon, 20);
	m.clearButtons();
	m.ShowCurrentLocation(0);
	//ouverture de la carte avec inf
	m.addImageButton(xresources+"check.png", ValidatedMergeSeparate(m, markerId, lat, lon, xdistanceMaxAllowed, ctr));
	m.addImageButton(xresources+"close.png", CancelOperation(m));
	m.setMarkerOnDrag(markerId, VerifyDistance_ensemble(m, markerId, selectedMarkersListID,Lat, lon, xdistanceMaxAllowed, ctr));

	numeric j=1;
	while j <= selectedMarkersListID.length() do
		markerId=selectedMarkersListID(j);
		MarkerEtatColor(m, markerId,"","","",0,50, 0, xresources);
		string categorie_inf = getlabel(CONS_SYMBOLOGIE_INFRASTRUCTURE_VS1, CONS_SYMBOLOGIE_INFRASTRUCTURE);
		string AgentText;
		AgentText="<b> Agent Responsable </b> :" + CONS_CODE_AR + "| " + strip(CONS_NOM_AR) +"<br/>";

		// if HashAgentName.contains(ID_AGENT) then 
			// AgentText = "<b> Agent Responsable </b> :" + ID_AGENT + " " + HashAgentName(ID_AGENT) +"<br/>";
		// endif;
		Description_function(m, markerId,key(RGE_FICHE_EDIFICE_DICT));
		inc(j);
	enddo;
	//Replacement de la nouvelle concession crée.

	//DrMap.setMarkerLocation(markerId, lat, lon);
end;

function selectMarkers(map m, numeric markerId, string  key_cons,numeric f_cons_statut_cons, string label_cons,numeric f_cons_ajout, string background, string Font, string ctr )
	// ??? Remise de la couleurs de départ à étudier ????
	if ctr="separate" then
		if selectedMarkersList.length()>1 then
			exit 0;
		endif;
	endif;
	//remplissage liste
	string cons=key_cons[21:5];
	numeric index = selectedMarkersList.seek(key_cons);
	string concession;
	if f_cons_statut_cons=9 then
		concession="INF";
	else
		if f_cons_ajout=1 then
			concession=label_cons;
		else
			concession=cons;
		endif;
	endif;
	if index=0 then //Pas encore choisi
		//Ajouter à liste et changer la couleur en blue
		//D
		m.setMarkerText(markerId, concession, 'blue', 'white');
		selectedMarkersList.add(key_cons);
		//sauvegarde des ID map des concessions à grisé /update
		selectedMarkersListID.add(markerId);

	else // déja présent
		m.setMarkerText(markerId, concession, background, "white");
		selectedMarkersList.remove(index);
		selectedMarkersListID.remove(index);
	endif;

end;

function MergeSeparateBatiment(map m, string xresources, numeric xdistanceMaxAllowed, string ctr)
	savesetting("valid_click", "oui");
	string dr=loadsetting("key_dr_current", "no");
	string qrt=loadsetting("key_quartier_current", "no");
	string markerText;
	if ctr="merge" then
		m.setTitle("Sélectionner les batiments à fusionner : ");
	else
		m.setTitle("Sélectionner le batiment à scinder : ");
	endif;
	m.clearButtons();
	m.clearMarkers();
	selectedMarkersList.clear();
	selectedMarkersListID.clear();
	//ouverture de la carte avec inf
	m.addImageButton(xresources+"select.png", RelocatePoint(m, xresources, xdistanceMaxAllowed, ctr));
	m.addImageButton(xresources+"close.png", CancelOperation(m));
	//DrMap.SetBaseMap(PathTpk + 'tpk_'+CODE_LOCALITE+'.tpk');
	string infoNouveau= InfoNewPoint_Function(CONS_AJOUT);
	forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt)   do
		if CONS_STATUT in 4 then
			next;
		endif;
		// Create a marker from listing table
		numeric markerId = m.addMarker(CONS_LAT, CONS_LON);
		MarkerEtatColor(m, markerId,key(RGE_FICHE_EDIFICE_DICT), CONS_ID_EDIFICE_LIBELLE, CONS_CODE_AR,CONS_STATUT_CONCESSION ,CONS_STATUT, CONS_AJOUT, xresources);
		infoNouveau = InfoNewPoint_Function(CONS_AJOUT);
		string PtBgColor;
		if CONS_STATUT_CONCESSION= 1 then 
			PtBgColor = '#800020';
		else
			PtBgColor = '#F3E5AB';
		endif;
		if CONS_STATUT <> 5 and loadsetting("valid_click", "no")="oui" then  //Exclure les cons supprimé
			m.setMarkerOnClick(markerId, selectMarkers(m, markerId, key(RGE_FICHE_EDIFICE_DICT),CONS_STATUT_CONCESSION, CONS_ID_EDIFICE_LIBELLE ,CONS_AJOUT, PtBgColor, "white", "merge"));
		endif;
		string categorie_inf = getlabel(CONS_SYMBOLOGIE_INFRASTRUCTURE_VS1, CONS_SYMBOLOGIE_INFRASTRUCTURE);
		string AgentText;
		AgentText="<b> Agent Responsable </b> :" + CONS_CODE_AR + "| " + strip(CONS_NOM_AR) +"<br/>";

		// if HashAgentName.contains(ID_AGENT) then 
			// AgentText = "<b> Agent Responsable </b> :" + ID_AGENT + " " + HashAgentName(ID_AGENT) +"<br/>";
		// endif;
		Description_function(m, markerId,key(RGE_FICHE_EDIFICE_DICT));
	endfor;
end;

function dr_map_function(numeric xdistanceMaxAllowed, string xPathProg, string xPathInput, string xPathTpk, string xresources, string menu_pff, string actor, string ctr)
	map m;
	m.setTitle(QRT_ID_LACALITE+ ' | ' + strip(CONS_NOM_LOCALITE_FC));
	m.clearMarkers();
	m.clearButtons();
	string dr=loadsetting("key_dr_current", "no");
	string qrt=loadsetting("key_quartier_current", "no");
	if dr="no" or qrt="no" then
		errmsg("Veuillez choir un dr et/ou une localité.");
		exit;
	endif;
	//Ajout de bouttons
	m.addImageButton(xresources + "plus.png", add_new_cons(m, xPathTpk, xdistanceMaxAllowed,xresources));
	m.addImageButton(xresources + "merge.png", MergeSeparateBatiment(m, xresources, xdistanceMaxAllowed, "merge"));
	m.addImageButton(xresources + "separate.png", MergeSeparateBatiment(m, xresources, xdistanceMaxAllowed, "separate"));
	// m.addImageButton("resources/separate.png", SeparateBuilding(m, xresources, xdistanceMaxAllowed));
	// m.addImageButton("resources/status.png", displaysMarkersStatus());
	
	m.addImageButton(xresources + "help.png", symbologie_function()); 
	m.addImageButton(xresources + "map.png", modeleCarte(m, xPathTpk, dr, 0));
	m.addImageButton(xresources + "close.png", close_map(m));
	m.ShowCurrentLocation(true);
	//
	
	if fileexist(xPathTpk+'tpk_'+dr+'.tpk') then
		m.setBaseMap(xPathTpk+'tpk_'+dr+'.tpk');
	else
		m.setBAseMap(Normal);
	endif;
	setfile(RGE_FICHE_EDIFICE_DICT, xPathInput+"concessions_"+actor+".csdb");
	setfile(RGE_FICHE_UNITE_DICT, xPathInput+"menages_"+actor+".csdb");
	// numeric i=1;
	// errmsg("ID_ACTOR : |%s|", ID_ACTOR);
	forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt) where CONS_CODE_AR=ID_ACTOR do
		string key_cons=key(RGE_FICHE_EDIFICE_DICT);
		// map_cons_list.add(key_cons);
		numeric nb = countcases(RGE_FICHE_UNITE_DICT(startswith, key_cons) where MEN_AJOUT<>6);
		numeric markerId = m.addMArker(CONS_LAT,CONS_LON);
		string cons_edif=maketext("%v", CONS_ID_EDIFICE[3:3]);
		if CONS_AJOUT in 1,2,3 then
			string lab="";
			if CONS_AJOUT=1 then
				lab="N";
			elseif CONS_AJOUT=2 then
				lab="F";
			elseif CONS_AJOUT=3 then
				lab="S";
			endif;
			cons_edif=CONS_ID_EDIFICE_LIBELLE[1:1]+CONS_ID_EDIFICE_LIBELLE[3:3];
		endif;
		if CONS_STATUT_CONCESSION=9 then
			cons_edif='INF';
		endif;
		numeric stat_collecte;
		// if CONS_TIRAGE=6 then
			// stat_collecte=5;
		// else
			// stat_collecte=CONS_STATUT;
		// endif;
		stat_collecte=CONS_STATUT;
		m.setMarkerText(markerId, cons_edif, color_status(key(RGE_FICHE_EDIFICE_DICT), stat_collecte), "white");
		// m.setMarkerDescription(markerId, maketext("Numéro cons : %s<br> Type habitat : %s<br>Type cons : %s<br>Nb ménage : %d<br>Statut cons : <font color='%s'> %s </font>"
													// ,CONS_ID_EDIFICE,getvaluelabel(CONS_TYPE_HABITAT),getvaluelabel(CONS_STATUT_CONCESSION), nb, cons_status_color(CONS_STATUT), getvaluelabel(CONS_STATUT)));
		m.setMarkerOnClickInfoWindow(markerId, Open_cons_function(m, key_cons, actor,xPathProg, xPathInput, menu_pff,ctr));
		
		string categorie_inf = getlabel(CONS_SYMBOLOGIE_INFRASTRUCTURE_VS1, CONS_SYMBOLOGIE_INFRASTRUCTURE);
		string AgentText;
		AgentText="<b> Agent Responsable </b> :" + CONS_CODE_AR + "| " + strip(CONS_NOM_AR) +"<br/>";

		// if HashAgentName.contains(ID_AGENT) then 
			// AgentText = "<b> Agent Responsable </b> :" + ID_AGENT + " " + HashAgentName(ID_AGENT) +"<br/>";
		// endif;
		Description_function(m, markerId,key(RGE_FICHE_EDIFICE_DICT));
	endfor;
	
	//dr_zoom_scaling();
	m.show();
end;
}
//************************** OTHER FUNCTION **************************************//
	//**************************************************************//

function Choice_option(numeric ctr)
	//gestion collecte
	if ctr in 1 then
		move to VIEW_QRT;
	endif;
	//stat
	if ctr in 2 then
		// LISTE_MEN_ENQ_REPORT.view();
		exit;
	endif;
	//sync
	if ctr in 3 then
		errmsg("En construction !");
		exit;
		
		if sync_data(app_current)=0 then
			exit;
		else
			reenter SUPCOM_QUEST;
		endif;
	endif;	
	//Fermer
	if ctr=9 then
		stop(1);
	endif;
end;

//Terminer le test
function Terminer_test_menu()
	if !fileexist(PathData+"test_"+ID_ACTOR+".csdb") then
		errmsg("Veuillez passer le test de sélection avant de faire un envoi pour correction.");
		exit 0;
	endif;
	setfile(RGE_TEST_DICT, PathData+"test_"+ID_ACTOR+".csdb");
	loadcase(RGE_USERS_DICT, ID_ACTOR);
	loadcase(RGE_TEST_DICT, ID_ACTOR);
	Terminer_test(1);
	writecase(RGE_TEST_DICT);
end;

{
function Integrer_remplant(numeric id_dr)
	string idDR=loadsetting("key_DR_string");
	array string  remplacant_array(50, 7);
	remplacant_array.clear();
	index_remplacant_a_integrer_array.clear();
	string id_ind, name_ind;
	string id = ID_ACTOR + idDR;
	numeric i=1;
	forcase CARTO_ECHANTILLON_DICT(startswith, id) where EXT_TIRAGE=9 and EXT_INTEGRATION<>1 do
		index_remplacant_a_integrer_array.add(key(CARTO_ECHANTILLON_DICT));
		remplacant_array(i, 1) =getlabel(EXT_COMMUNE, EXT_DR_ID[1:8]);
		remplacant_array(i, 2) = strip(EXT_NOM__STRUCTURE);
		remplacant_array(i, 3) = edit("99 9999 99 99", EXT_NOM_TEL_1);
		remplacant_array(i, 4) = edit("99 9999 99 99", EXT_NOM_TEL_2);
		remplacant_array(i, 5) = strip(EXT_ADRESSE);
		remplacant_array(i, 6) = getlabel(EXT_TIRAGE, EXT_TIRAGE);
		inc(i);
	endfor;
	
	if index_remplacant_a_integrer_array.length()=0 then
		errmsg("La liste des remplaçants est vide.");
		exit;
	endif;
	numeric IndSelection = showarray("Choisir un remplaçant", remplacant_array, 
		title("Commune","Raison sociale", "Tel 1",  "Tel 2", "Adresse",  "Tirage"));
	if IndSelection>0 then
		numeric choice = accept("Intégrer le ménage choisi ?",
									"Oui", "Non");
		if choice <>1 then 
			exit;
		endif;
		string key_remplacent = index_remplacant_a_integrer_array(IndSelection);
		if loadcase(CARTO_ECHANTILLON_DICT, key_remplacent) then
			EXT_INTEGRATION=1;
			writecase(CARTO_ECHANTILLON_DICT);
		else
			errmsg("Loadcase non chargé");
			exit;
		endif;
	else
		exit;
	endif;
	errmsg("Opération réussie.");
	reenter VIEW_CONS;
end;
}

PROC MENU_ENQ_FF

PROC SUPCOM_QUEST
preproc
	PathProg = pathname(application);
	PathParam = PathProg + "../param/";
	PathTemp = PathProg + "../temp/";
	PathInputlogin=PathProg + "../input/";
	PathResources=PathProg + "../resources/";
	// errmsg("SUPCOM_QUEST");
	if !fileexist(PathInputlogin+"Termine_formation.txt") then
		PathInput=PathProg + "../formation/input/";
		PathData=PathProg +  "../formation/data/";
		PathTpk=PathProg +   "../formation/tpk/";
	else
		PathInput=PathProg + "../input/";
		PathData=PathProg +  "../data/";
		PathTpk=PathProg +   "../tpk/";
	endif;
	
	if !fileexist(PathInput+"Termine_formation.txt") then
		userbar(clear);
		userbar(add button,"Terminer le test ", Terminer_test_menu());
		userbar(add text,"------------------");
		userbar(add button,"Modifier mon nom et prénom ", update_agent());
		userbar(add text,"------------------");
		userbar(add button,"Modifier mon numéro de téléphone", update_tel());
		userbar(add text,"------------------");
		userbar(add button,"RECODE LOGIN", recode_login(1));
		userbar(add button,"Envoi des données collectées ", send_date_coll());
		userbar(add button,"Afficher le manuel AR ", view_manual_app(PathInputlogin, "CARTO_AR"));
		userbar(add button,"Afficher la lettre d'introduction ", view_manual_app(PathInputlogin, "lettre"));
		userbar(Show);
	else
		userbar(clear);
		userbar(add button,"Modifier mon nom et prénom ", update_agent());
		userbar(add text,"------------------");
		userbar(add button,"Modifier mon numéro de téléphone", update_tel());
		userbar(add text,"------------------");
		userbar(add button,"Suppression des quartiers", delete_quartier());
		userbar(add text,"------------------");
		userbar(add button,"Actualiser mes informations personnelles ", update_agent_serveur());
		userbar(add button,"Afficher le manuel AR ", view_manual_app(PathInputlogin, "CARTO_AR"));
		userbar(add button,"Afficher la lettre d'introduction ", view_manual_app(PathInputlogin, "lettre"));
		// userbar(add button,"Corriger la progression ", corr_progress_deploy(0));
		userbar(Show);

	endif;
PROC SUPCOM_QUEST_FORM
preproc
	ID_ACTOR=getoperatorid();
	//Recup infos formateur et/ou CE
	setfile(RGE_USERS_DICT, PathInputlogin+'login_' + ID_ACTOR + '.csdb');
	if ! loadcase(RGE_USERS_DICT, ID_ACTOR) then 
		errmsg("Erreur de chargement des informations de l'utilisateur.");
		stop(1);
	endif;
	
	NOM_ENQUETEUR=USER_NAME;
	CODE_FORMATEUR=USER_FORMATEUR;
	NOM_FORMATEUR=strip(USER_NAME_FORMATEUR);
	tel_enq_ini=USER_PHONE;
	
	if USER_TYPE=1 then
		//pour la collecte
		CODE_CE=USER_CE;
		NOM_CE=strip(USER_NAME_CE);
	else
		//pour la formation
		CODE_CE=ID_ACTOR;
		NOM_CE=strip(USER_NAME);
	endif;
		
	nom_enq_ini=strip(NOM_ENQUETEUR);
	
	// if loadsetting("version", "no")<>"no" then
		// version=loadsetting("version", "no");
	// endif;
	
	if fileexist(PathInputlogin+"version_enq.txt") then
		setfile(fileTowrite, PathInputlogin+"version_enq.txt");
		if fileread(fileTowrite, ReadString) then
			version=strip(ReadString[1:5]);
		endif;
	endif;
	//Définir le type d'application
	string date_fin_formation;
	if !fileexist(PathInputlogin+"Termine_formation.txt") then
		app_current = "formation";
		app_name = "Application de formation";
		
		setfile(fileTowrite, PathInputlogin+"formation.txt");
		if fileread(fileTowrite, ReadString) then
			date_fin_formation=strip(ReadString[1:8]);
		endif;
		
		numeric date_diff = datediff(sysdate("YYYYMMDD"), tonumber(date_fin_formation),"d");
		// errmsg("date_formation : %d; date_diff = %d", tonumber(date_fin_formation), date_diff);
		if date_diff<=0 then
			errmsg("Ceci est une application de formation. Elle est expirée depuis le %s. Veuillez passer en mode collecte depuis le menu login.", edit("9999-99-99", tonumber(date_fin_formation)));
			// stop(0);
		endif;
	else
		app_current = "collecte";
		app_name = "Application de collecte";
	endif;
	//Arrêter si l'agent est en formation
	if USER_TYPE in 1 and app_current="formation" then
		errmsg("Vous êtes un agent enquêteur. Veuillez passer en mode collecte avant de continuer.");
		stop(1);
	endif;
	//Pour le test
	if fileexist(PathInputlogin+"time_test.txt") then
		setfile(fileTowrite, PathInputlogin+"time_test.txt");
		if fileread(fileTowrite, ReadString) then
			time_test_seconde=tonumber(strip(ReadString[1:10]));;
		endif;
	endif;
	// errmsg("time_test_seconde : %d", time_test_seconde);
	
	//Définir si le serveur test ou prod
	if fileexist(PathInputlogin+"app.txt") then
		setfile(fileTowrite, PathInputlogin+"app.txt");
		if fileread(fileTowrite, ReadString) then
			app=strip(ReadString[1:10]);
		endif;
	endif;
	
	//dr de travail
	dr_work = loadsetting("key_dr_current", "no");
	
	//Ouverture
	// errmsg("%s", loadsetting("Open_menu", "no"));
	if loadsetting("Open_menu")="qrt" then
		skip to VIEW_QRT;
	elseif loadsetting("Open_menu")="cons" then
		skip to VIEW_CONS;
	elseif loadsetting("Open_menu")="menage" then
		skip to VIEW_MEN;
	endif;
PROC ACTION
onfocus
	string dr_current = loadsetting("key_dr_current", "no");
	// dr_work = loadsetting("key_dr_current", "no");
	// errmsg("commune_work : %s", commune_work);
	if app_current="formation" then
		setvalueset($, ACTION_VS1);
	else
		setvalueset($, ACTION_VS2);
	endif;
	{
	if dr_current="no" then
		if app_current="formation" then
			action_cm_vs.add("Récupération des données de base pour la formation", 95);
			action_cm_vs.add("Choisir une commune", 0);
			action_cm_vs.add("Faire le test de selection", 90);
			action_cm_vs.add("Synchronisation du test pour correction", 91);
			
			action_cm_vs.add("Fermer l'application", 9);
			setvalueset($, action_cm_vs);
		else
			action_cm_vs.add("Récupération des données de base pour la formation", 81);
			action_cm_vs.add("Choisir une commune", 0);
			
			action_cm_vs.add("Changement de tablette pour un enquêteur", 82);
			action_cm_vs.add("Synchronisation avec le chef d'équipe", 80);
			action_cm_vs.add("Fermer l'application", 9);
			setvalueset($, action_cm_vs);
		endif;
	else
		// commune_work = getlabel(CCODECOM, dr_current); // Les communes ne correspondent pas à la codif de l'ansd
		commune_work = loadsetting("name_dr_current");
		// errmsg("commune_work : %s", 	);
		if app_current="formation" then
			setvalueset($, ACTION_VS1);
		else
			setvalueset($, ACTION_VS2);
		endif;
	endif;
	}
	
postproc

	//******************************** GLOBAL ********************************//
	
	//Récupération des données de base
	if $ in 95,81 then
		recup_data_base($);
		reenter;
	endif;
	
	//Choisir un dr
	if $ in 0 then
		// if app_current<>'formation' then
			// loadcase(RGE_USERS_DICT, ID_ACTOR);
			// numeric nb_jour = datediff(USER_LASTCONNECT, sysdate("YYYYMMDD"));
			// if nb_jour=2 and IS_CLOSED=1 then
				// errmsg("Vous avez fait deux jours sans synchroniser, à partir de demain vous ne pouvez plus continuser sans synchroniser avec votre chef d'éuipe.");
				// IS_CLOSED=0;
				// writecase(RGE_USERS_DICT);
			// elseif nb_jour>=3 or special(nb_jour) then
				// if USER_LASTCONNECT<>20241106 then
					// errmsg("Vous avez fait trois jours sans synchroniser avec votre chef d'équipe. Vous devez synhroniser avec votre chef d'équipe avant de continuer.");
					// reenter;
				// endif;
			// endif;
		// endif;
		move to VIEW_DR;
	endif;

	//Collecter un ménage 
	if $=1 then
		if dr_current="no" then
			errmsg("Veuillez choisir le DR de travail avant de continuer.");
			reenter;
		endif;
		move to VIEW_QRT;
	endif;
	
	//Tableau de bord
	if $ in 2 then
		errmsg("En construction !");
		reenter;
		
		// LISTE_MEN_ENQ_REPORT.view();
		reenter;
	endif;
	
	//Fermer
	if $=9 then
		stop(1);
	endif;
	
	//******************************** FORMATION ********************************//
	//Pour la présentation ESS
	if $ in 90,91 then
		reenter;
	endif;
	
	//Test de sélection
	if $ in 90 then
		test_selection(ID_ACTOR, "den_menu_enq",
						time_test_seconde, PathProg, PathInput, PathData);
		reenter;
	endif;
	
	//Sync data formation
	if $=92 then
		send_date_coll();
		reenter;
	endif;
	
	//Sync data test
	if $=91 then
		sync_test();
		reenter;
	endif;

	//******************************** COLLECTE ********************************//
	//synchronisation
	if $ in 80 then
		sync_data(app_current);
		reenter;
	endif;
	
	if $ in 81 then
		// type_sync_blth=1;
		// recup_quartier_bluetooth(ID_ACTOR);
		// recup_affectation();
		reenter;
	endif;
	
	if $ in 82 then
		backup_agent();
		reenter;
	endif;

	if $ in 83 then
		// sync_signatures_bluetooth();
		// sync_signatures();
		reenter;
	endif;
PROC CHECK
preproc
	if type_sync_blth=1 then
		recup_quartier_bluetooth(ID_ACTOR);
		reenter ACTION;
	endif;
	$=1;
	noinput;
	
postproc
	// sync_data();
	reenter SUPCOM_QUEST;
PROC VIEW_COMMUNE
preproc
	savesetting("Open_menu", "no");
	if init_dictionaries(0)=0 then
		reenter ACTION;
	endif;
	
	LISTE_DR_ENQ.view();
	reenter SUPCOM_QUEST;

PROC VIEW_QUARTIER
preproc
	savesetting("Open_menu", "no");
	init_dictionaries(0);
	
	LISTE_QUARTIER_ENQ.view();
	reenter SUPCOM_QUEST;

PROC VIEW_CONS
// preproc
	// savesetting("Open_menu", "no");
	// init_dictionaries(0);
	// string key_qrt;
	// if loadsetting("key_quartier_current", "no")<>"no" then
		// key_qrt=loadsetting("key_quartier_current", "no");
	// endif;
	// errmsg("ok");
	// loadcase(RGE_FICHE_QUARTIER_DICT, key_qrt);
	// dr_map_function(app_current, distanceMaxAllowed, PathProg, PathInput, PathTpk, PathResources, 'den_menu_enq', ID_ACTOR, 'AR');
	// reenter VIEW_QRT;
	
PROC VIEW_CONCESSION
preproc
	savesetting("Open_menu", "no");
	savesetting("return", "no");
	savesetting("cons_select", "no");
	init_dictionaries(0);
	string key_qrt;
	if loadsetting("key_quartier_current", "no")<>"no" then
		key_qrt=loadsetting("key_quartier_current", "no");
	endif;
	loadcase(RGE_FICHE_QUARTIER_DICT, key_qrt);
	string result;
	dr_map_function(app_current, distanceMaxAllowed, PathProg, PathInput, PathTpk, PathResources, 'den_menu_enq', ID_ACTOR, 'AR');
	result = loadsetting("cons_select");
	// errmsg("result = |%s|", result);
	if length(strip(result))>=13 then
		CHOIX_CONS=result;
		skip;
	endif;
	if loadsetting("return", "no")="cons" then
		reenter VIEW_CONS;
	endif;
	reenter VIEW_QRT;
PROC CHOIX_CONS
preproc
	noinput;

postproc
		//fonction d'affectation
	string dr=loadsetting("key_dr_current", "no");
	string qrt=loadsetting("key_quartier_current", "no");
	
	if count(CHOIX_CONS_SINGLE where CHOIX_CONS_SINGLE<>"")=0 then
		errmsg("Vous devez choisir les concessions à affecter.");
		reenter VIEW_CONS;
	endif;
	errmsg("Validez-vous l'envoie des %d concessions au chef d'équipe",
			count(CHOIX_CONS_SINGLE where CHOIX_CONS_SINGLE<>""))
	select("Oui", continue, "Non", VIEW_CONS);
	
	// numeric nb_cons_selected=0;
	// list string my_list_cons;
	// my_list_cons.clear();
	// loadcase(RGE_USERS_DICT, ID_ACTOR);
	// forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt) do
		// if seek(CHOIX_CONS_SINGLE=key(RGE_FICHE_EDIFICE_DICT))>0 then 
			// my_list_cons.add(key(RGE_FICHE_EDIFICE_DICT));
			// CONS_CODE_AR="";
			// CONS_NOM_AR="";
			// writecase(RGE_FICHE_EDIFICE_DICT);
			// forcase RGE_FICHE_UNITE_DICT(startswith, key(RGE_FICHE_EDIFICE_DICT)) do
				// MEN_CODE_AR="";
				// MEN_NOM_AR="";
				// writecase(RGE_FICHE_UNITE_DICT);
			// endfor;
			// inc(nb_cons_selected);
		// endif;
	// endfor;

	server_name = "TB"+qrt[20:13] +ID_ACTOR;
	// errmsg("quartier_current : |%s|; enq_choice : |%s|", quartier_current, enq_choice);
	if !syncconnect(bluetooth, server_name) then 
		errmsg("Echec de la connexion avec l'enquêteur.");
		// forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt) do
			// if seek(CHOIX_CONS_SINGLE=key(RGE_FICHE_EDIFICE_DICT))>0 then 
				// ///STATUT=1;
				// CONS_CODE_AR=ID_ACTOR;
				// CONS_NOM_AR=USER_NAME;
				// writecase(RGE_FICHE_EDIFICE_DICT);
				// forcase RGE_FICHE_UNITE_DICT(startswith, key(RGE_FICHE_EDIFICE_DICT)) do
					// UNITE_CODE_AR=ID_ACTOR;
					// UNITE_NOM_AR=USER_NAME;
					// writecase(RGE_FICHE_UNITE_DICT);
				// endfor;
			// endif;
		// endfor;
		syncdisconnect();
		reenter VIEW_CONS;
	endif;

	numeric nb_cons_selected=0;
	list string my_list_cons;
	my_list_cons.clear();
	loadcase(RGE_USERS_DICT, ID_ACTOR);
	forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt) do
		if seek(CHOIX_CONS_SINGLE=key(RGE_FICHE_EDIFICE_DICT))>0 then 
			my_list_cons.add(key(RGE_FICHE_EDIFICE_DICT));
			EDIF_CODE_AR="";
			EDIF_NOM_AR="";
			EDIF_RETURN_CONS=1;
			writecase(RGE_FICHE_EDIFICE_DICT);
			forcase RGE_FICHE_UNITE_DICT(startswith, key(RGE_FICHE_EDIFICE_DICT)) do
				UNITE_CODE_AR="";
				UNITE_NOM_AR="";
				writecase(RGE_FICHE_UNITE_DICT);
			endfor;
			inc(nb_cons_selected);
		endif;
	endfor;
	
	// errmsg("Erreur d'envoi des affectations à l'enquêteur %s", USER_LOGIN + " | " + strip(USER_NAME));
	// send;
	numeric i=1;
	forcase RGE_FICHE_EDIFICE_DICT(startswith, qrt) do
		if seek(CHOIX_CONS_SINGLE=key(RGE_FICHE_EDIFICE_DICT))>0 then
		// errmsg("send i : %d", i);
			if	!syncdata(PUT, RGE_FICHE_EDIFICE_DICT, CHOIX_CONS_SINGLE(i)) then
				syncdisconnect();
				errmsg("Veuillez renvoyé à nouveau les concessions qui ne sont pas trnasférés.");
				break;
			endif;
			if	!syncdata(PUT, RGE_FICHE_UNITE_DICT, CHOIX_CONS_SINGLE(i)) then
				syncdisconnect();
				errmsg("Veuillez renvoyé à nouveau les concessions qui ne sont pas trnasférés.");
				break;
			endif;
			numeric index=my_list_cons.seek(key(RGE_FICHE_EDIFICE_DICT));
			my_list_cons.remove(index);
			inc(i);
		endif;
	endfor;
	syncdisconnect();
	
	//désaffectation
	numeric j=1;
	if my_list_cons.length()>0 then
		numeric k=0;
		do varying k=1 while k<=my_list_cons.length() 
			string key_cons=my_list_cons(k);
			loadcase(RGE_FICHE_EDIFICE_DICT, key_cons);
			EDIF_CODE_AR=ID_ACTOR;
			EDIF_NOM_AR=USER_NAME;
			EDIF_RETURN_CONS=notappl;
			writecase(RGE_FICHE_EDIFICE_DICT);
			forcase RGE_FICHE_UNITE_DICT(startswith, key(RGE_FICHE_EDIFICE_DICT)) do
				UNITE_CODE_AR=ID_ACTOR;
				UNITE_NOM_AR=USER_NAME;
				writecase(RGE_FICHE_UNITE_DICT);
			endfor;
		enddo;
	endif;
	
	//mise à jour statut liste DR
	if i=0 then
		errmsg("Aucun ménage n'a été envoyé.");
	else
		errmsg("Envoi réussie");
	endif;
	reenter VIEW_CONS; 
PROC VIEW_MENAGE
preproc
	savesetting("Open_menu", "no");
	savesetting("type", "no");
	init_dictionaries(0);
	if loadsetting("key_cons_current", "no")<>"no" then
		string key_cons=loadsetting("key_cons_current", "no");
		statut_edif_update(key_cons);
	endif;
	LISTE_UNITE_ENQ.view();
	reenter VIEW_CONS;
