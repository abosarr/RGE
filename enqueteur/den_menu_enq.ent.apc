{
function read_gps2(numeric ctr)
	string id_str = list_menage(ctr);
	string id_dr = list_menage(ctr)[7:12];
	string id_reg = list_menage(ctr)[7:2];
	string id_code_str = list_menage(ctr)[19:2];
	string num_str = list_menage(ctr)[21:8];
	
	//errmsg("id : %s", id);
	if !fileexist(PathData+"menages_"+ID_ACTOR+".csdb") then
		errmsg("Veuillez démarrer la collecte avant de capter le signal GPS.");
		exit;
	endif;
	if !setfile(CARTO_RGE_FICHE_UNITE_DICT, PathData+"menages_"+ID_ACTOR+".csdb") then
		errmsg("Veuillez démarrer la collecte avant de capter le signal GPS.");
		exit;
	endif;
	if loadcase(CARTO_RGE_FICHE_UNITE_DICT, id_str) then
		if LON<>notappl and LAT<>notappl then
			errmsg("Le signal GPS est déjà capté. Voulez-vous le capté à nouveau ?");
			numeric choice= accept("Choisir une option",
					"Continuer", 
					"Annuler");
			if choice<>1 then 
				exit;
			endif;
		endif;
	else
		errmsg("Veuillez démarrer la collecte avant de capter le signal GPS.");
		exit;
	endif;
	
	numeric choice1= accept("Choisir une option",
							"Capter le signal GPS", 
							"Annuler");
	if choice1<>1 then 
		exit;
	endif;
	
	numeric la; numeric lo;
	gps(open);
	if ! gps(read, 10) then  
		errmsg("Signal GPS non capté. Vérifier si votre GPS fonctionne correctement");
		exit;
	endif;
	gps(close);
	la= gps(latitude);
	lo=gps(longitude);
	
	if la<>notappl or lo<>notappl then
		LAT= gps(latitude);
		LON=gps(longitude);
		writecase(CARTO_RGE_FICHE_UNITE_DICT);
		loadcase(CARTO_ECHANTILLON_DICT, id_str);
		EXT_LAT=gps(latitude);
		EXT_LON=gps(longitude);		
		writecase(CARTO_ECHANTILLON_DICT);
	endif;
	errmsg("Longitude : %f | Latitude : %f", LON, LAT);
	reenter VIEW_CONS;
end;

}

