function backup()
	list string filelisting;
	//path
	PathProg = pathname(application);
	PathInput = PathProg + "../input/";
	PathTemp = PathProg + "../temp/";
	//PathPrep= PathProg + "../prep/";
	PathData= PathProg + "../data/";
	PathBackup=PathProg + "../backup";
	dircreate(PathBackup);
	//fermer l'ensemble des fichiers 
	filelisting.clear();
	dirlist(filelisting, PathInput, recursive); 
	if compress(pathtemp+"input.zip",filelisting)=default then
		errmsg("Fichier PathInput non capté/");
	endif;
	//fermer les fichiers en cours
	CLOSE(RGE_FICHE_QUARTIER_DICT);
	CLOSE(RGE_USERS_DICT);
	CLOSE(RGE_FICHE_EDIFICE_DICT);
	CLOSE(RGE_FICHE_UNITE_DICT);
	//zipper les fichiers
	filelisting.clear();
	dirlist(filelisting, PathPrep, recursive); 
	if compress(pathtemp+"prep.zip",filelisting)=default then
		errmsg("Fichier PathPrep non capté/");
	endif;
	filelisting.clear();
	dirlist(filelisting, PathData, recursive); 
	if compress(pathtemp+"data.zip",filelisting)=default then
		errmsg("Fichier PathData non capté/");
	endif;
	//regroupement
	filelisting.clear();
	filelisting.add(pathtemp+"input.zip");
	filelisting.add(pathtemp+"prep.zip");
	filelisting.add(pathtemp+"data.zip");
	//historisation
	string compressed_file=Pathtemp+"backup_isblsm_" + getoperatorID() + "_" +timestring("%Y-%m-%d", timestamp())+".zip";
	compress(compressed_file, filelisting);
	//filecopy(compressed_file, pathname(Downloads));
	if !filecopy(compressed_file, PathBackup) then
		errmsg("Une erreur a été rencontrée lors du backup local");
	endif;
	
	if !filecopy(compressed_file, pathname(Downloads)) then
		errmsg("Une erreur a été rencontrée lors du backup local");
	endif;
end;

function backup_synfile(numeric ctr)
	if ctr=1 then
		string PathSign = PathInput+ "geojson/";
		if fileexist(PathTemp+'my_geojson_compress.zip') then
			filedelete(PathTemp+'my_geojson_compress.zip');
		endif;
		list string filelisting;
		filelisting.clear();
		dirlist(filelisting, PathSign, recursive);
		if special(compress(PathTemp+"my_geojson_compress.zip", filelisting)) then
			exit 0;
		endif;
		exit 1;
	endif;
end;

function sync_geojson_bluetooth()
	if backup_synfile(1)=0 then
		exit 0;
	endif;
	if !syncfile(PUT, pathTemp+"my_geojson_compress.zip") then
		errmsg("Les fichiers de geojson ne sont pas retrouvés.");
		exit 0;
	endif;
	exit 1;
end;

function sync_data(string type)
	if type="formation" then
		init_dictionaries(2);
		
		if connect_to_serveur("serveur_data", app)=0 then
			exit 0;
		endif;
		numeric i=0;
		//Both ne fonctionne pas bien
		if !syncdata(PUT, RGE_FICHE_QUARTIER_DICT, CODE_FORMATEUR) then
			errmsg("Les informations des quartiers ne sont pas envoyées.");
			inc(i);
		endif;
		if !syncdata(GET, RGE_FICHE_EDIFICE_DICT, CODE_FORMATEUR) then
			errmsg("Les informations des concessions ne sont pas envoyées.");
			inc(i);
		endif;
		
		if !syncdata(PUT, RGE_FICHE_UNITE_DICT, CODE_FORMATEUR) then
			errmsg("Les informations des ménages ne sont pas envoyées.");
			inc(i);
		endif;
		if i<>0 then
			errmsg("L'opération ne s'est pas bien passée.");
			exit 0;
		else
			errmsg("Opération réussie.");
			exit 1;
		endif;
	else
		//Sync bluetooth avec le CE
		numeric choice=0;
		string text=maketext("Les données collectées seront envoyées au chef d'équipe d'équipe %s| %s. Voulez vous continuer cette opération ?", CODE_CE, NOM_CE);
		choice=accept(text, 
						"Oui", "Non");
		if choice<>1 then
			reenter;
		endif;
		init_dictionaries(1);
		string serveur_name = "TABB"+ID_ACTOR;
		if !syncconnect(bluetooth, serveur_name) then
			errmsg("Connection bluetooth non établie.");
			exit 0;
		endif;
		
		loadcase(RGE_USERS_DICT, ID_ACTOR);
		numeric lastconnect_old = USER_LASTCONNECT;
		USER_LASTCONNECT=sysdate("YYYYMMDD");
		USER_VERSION=tonumber(version);
		IS_CLOSED=1;
		writecase(RGE_USERS_DICT);
		init_dictionaries(2);
		
		numeric i=0;
		if !syncdata(PUT, RGE_USERS_DICT, ID_ACTOR) then
			errmsg("Les informations de l'enquêteur ne sont pas envoyées.");
			inc(i);
		endif;
		// if !syncdata(PUT, RGE_FICHE_QUARTIER_DICT, CODE_FORMATEUR) then
			// errmsg("Les informations des quartiers ne sont pas envoyées.");
			// inc(i);
		// endif;
		if !syncdata(PUT, RGE_FICHE_EDIFICE_DICT, CODE_FORMATEUR) then
			errmsg("Les informations des concessions ne sont pas envoyées.");
			inc(i);
		endif;
		
		if !syncdata(PUT, RGE_FICHE_UNITE_DICT, CODE_FORMATEUR) then
			errmsg("Les informations des ménages ne sont pas envoyées.");
			inc(i);
		endif;
		
		//Envoi des fichiers geojson
		if sync_geojson_bluetooth()=0 then
			inc(i);
		endif;
		syncdisconnect();
		
		//finalisation
		if i<>0 then
			loadcase(RGE_USERS_DICT, ID_ACTOR);
			USER_LASTCONNECT=lastconnect_old;
			IS_CLOSED=0;
			writecase(RGE_USERS_DICT);
			errmsg("L'opération ne s'est pas bien passée.");
			exit 0;
		else
			errmsg("Opération réussie.");
			exit 1;
		endif;
	endif;
end;


function update_agent()
	init_dictionaries(1);
	if !loadcase(RGE_USERS_DICT, ID_ACTOR) then
		errmsg("Login non valide.");
		exit;
	endif;
	string name_old=strip(USER_NAME);
	string name_wrk = prompt("Indiquez votre nom et prénom : ", name_old, Uppercase);
	if length(strip(name_wrk))<2 then
		errmsg("Veuillez entrer un nom valide.");
		exit;
	endif;
	USER_NAME=name_wrk;
	writecase(RGE_USERS_DICT);
	reenter SUPCOM_QUEST;
end;

function update_tel()
	init_dictionaries(1);
	if !loadcase(RGE_USERS_DICT, ID_ACTOR) then
		errmsg("Login non valide.");
		exit;
	endif;
	string tel_old=edit("999999999", USER_PHONE);
	string tel_wrk = prompt("Indiquez votre numéro de téléphone : ", tel_old, Uppercase);
	
	if !regexmatch(maketext("%d",tonumber(tel_wrk)), "^(77|76|75|78|70|33|30)[0-9]{7}$") then
		errmsg("Le numéro indiqué n'est pas correct");
		exit;
	endif;
	
	if length(strip(tel_wrk))<2 then
		errmsg("Veuillez entrer numéro de téléphone valide.");
		exit;
	endif;
	USER_PHONE=tonumber(tel_wrk);
	writecase(RGE_USERS_DICT);
	reenter SUPCOM_QUEST;
end;
//************************** FORMATION **************************************//
	//**************************************************************//
	
function sync_test()
	if !fileexist(PathData+"test_"+ID_ACTOR+".csdb") then
		errmsg("Veuillez passer le test de sélection avant de faire un envoi pour correction.");
		exit 0;
	endif;
	setfile(RGE_TEST_DICT, PathData+"test_"+ID_ACTOR+".csdb");
	if !loadcase(RGE_TEST_DICT, ID_ACTOR) then
		errmsg("Veuillez passer le test avant de synchroniser.");
		exit;
	endif;
	if QSTATUT_TEST<>1 then
		errmsg("Veuillez terminer le test avant de synchroniser pour correction.");
		exit;
	endif;
	if connect_to_serveur("serveur_data", app)=0 then
		exit 0;
	endif;
	if !syncdata(PUT, RGE_USERS_DICT, ID_ACTOR) then
		errmsg("Les informations de l'agent ne sont pas envoyées.");
		exit;
	endif;
	if !syncdata(PUT, RGE_TEST_DICT, ID_ACTOR) then
		errmsg("Les données de test ne sont pas envoyées.");
		exit;
	endif;
	errmsg("Félicitations ! Les données de test sont envoyées avec succés pour correction.");
	loadcase(RGE_USERS_DICT, ID_ACTOR);
	SYNC_CONTROLE_COUNT=1;
	writecase(RGE_USERS_DICT);
	exit;
end;

function recode_login(numeric ctr)
	// init_dictionaries(1);
	if ctr=2 then
		forcase RGE_FICHE_QUARTIER_DICT do
			QRT_CODE_SUP=CODE_FORMATEUR;
			QRT_NOM_SUP=strip(NOM_FORMATEUR);
			QRT_CODE_CE=CODE_CE;
			QRT_NOM_CE=strip(NOM_CE);
			QRT_CODE_AR=ID_ACTOR;
			QRT_NOM_AR=strip(NOM_ENQUETEUR);
			writecase(RGE_FICHE_QUARTIER_DICT);
		enddo;
	else
		forcase RGE_FICHE_QUARTIER_DICT do
			QRT_CODE_SUP=CODE_FORMATEUR;
			QRT_NOM_SUP=strip(NOM_FORMATEUR);
			QRT_CODE_CE=CODE_CE;
			QRT_NOM_CE=strip(NOM_CE);
			QRT_CODE_AR=ID_ACTOR;
			QRT_NOM_AR=strip(NOM_ENQUETEUR);
			writecase(RGE_FICHE_QUARTIER_DICT);
		enddo;
		forcase RGE_FICHE_EDIFICE_DICT do
			EDIF_CODE_SUP=CODE_FORMATEUR;
			EDIF_NOM_SUP=strip(NOM_FORMATEUR);
			EDIF_CODE_CE=CODE_CE;
			EDIF_NOM_CE=strip(NOM_CE);
			EDIF_CODE_AR=ID_ACTOR;
			EDIF_NOM_AR=strip(NOM_ENQUETEUR);
			writecase(RGE_FICHE_EDIFICE_DICT);
		enddo;
		forcase RGE_FICHE_UNITE_DICT do
			UNITE_CODE_SUP=CODE_FORMATEUR;
			UNITE_NOM_SUP=strip(NOM_FORMATEUR);
			UNITE_CODE_CE=CODE_CE;
			UNITE_NOM_CE=strip(NOM_CE);
			UNITE_CODE_AR=ID_ACTOR;
			UNITE_NOM_AR=strip(NOM_ENQUETEUR);
			writecase(RGE_FICHE_UNITE_DICT);
		enddo;
	endif;
	if ctr=1 then
		errmsg("L'opération a réussie.");
		reenter SUPCOM_QUEST;
	endif;
end;

function send_date_coll()
	init_dictionaries(2);
	// string cswb;
	// if app="test" then
		// cswb="test";
	// else
		// cswb="serveur_input";
	// endif;
	if connect_to_serveur('serveur_input', app)=0 then
		exit 0;
	endif;
	numeric i=0;
	if !syncdata(GET, RGE_FICHE_EDIFICE_DICT, CODE_FORMATEUR) then
		errmsg("Les informations des concessions ne sont pas envoyées.");
		inc(i);
	endif;
	if !syncdata(PUT, RGE_FICHE_UNITE_DICT, CODE_FORMATEUR) then
		errmsg("Les informations des ménages ne sont pas envoyées.");
		inc(i);
	endif;
	if i=0 then
		errmsg("Opération réussie.");
	else
		errmsg("Opération échouée");
	endif;
end;

function recup_data_base(numeric ctr)
	string my_label, my_file, my_file_serveur;
	if ctr=95 then
		my_label="Récupération des données de base pour la formation. Voulez vous continuer ?";
		my_file_serveur="/carto/tpk_formation/";
	else
		my_label="Récupération des données de base pour la collecte (DR et Tpk). Voulez vous continuer ?";
		my_file_serveur="/carto/tpk/";
	endif;
	numeric choice=0;
	choice = accept(my_label,
					"Oui", "Non");
	if choice<>1 then
		reenter;
	endif;
	init_dictionaries(1);
	if connect_to_serveur("serveur_input", app)=0 then
		reenter;
	endif;
	numeric i=0;
	close(RGE_FICHE_QUARTIER_DICT);
	setfile(RGE_FICHE_QUARTIER_DICT, PathTemp + 'quartiers_' + ID_ACTOR + '.csdb', create);
	if !syncdata(GET, RGE_FICHE_QUARTIER_DICT, CODE_FORMATEUR) then
		errmsg("Les quartiers ne sont pas récupérés.");
		exit;
	endif;
	if ctr=95 then
		if !syncdata(GET, RGE_FICHE_EDIFICE_DICT, CODE_FORMATEUR) then
			errmsg("Les données l'échantillon ne sont pas envoyées.");
			exit;
		endif;
		if !syncdata(GET, RGE_FICHE_UNITE_DICT, CODE_FORMATEUR) then
			errmsg("Les données l'échantillon ne sont pas envoyées.");
			exit;
		endif;
		recode_login(0);
	else
		if app="test" then
			recode_login(2);
		endif;
	endif;
	// if app="test" and app_current="collecte" then
		// recode_login(2);
	// endif;
	//download tpk des quartiers
	// string my_filter="";
	// if app_current="collecte" then
		// my_filter=CODE_CE;
	// endif;
	list string my_tpk_dr;
	list string my_qrt;
	my_tpk_dr.clear();
	string my_ce;
	forcase RGE_FICHE_QUARTIER_DICT(startswith, CODE_FORMATEUR) where QRT_CODE_CE=CODE_CE  do
		my_qrt.add(key(RGE_FICHE_QUARTIER_DICT));
		if my_tpk_dr.seek(QRT_ID_DR)=0 then
			my_tpk_dr.add(QRT_ID_DR);
		endif;
	endfor;
	// téléchargement à nouveaux des nouveaux dr & quatrtiers
	init_dictionaries(1);
	numeric k=0;
	do varying k=1 while k<=my_qrt.length()
		string qrt_curr = my_qrt(k);
		if !syncdata(GET, RGE_FICHE_QUARTIER_DICT, qrt_curr) then
			errmsg("Les quartiers ne sont pas récupérés.");
			exit;
		endif;
	enddo;
	
	// errmsg("%d DR trouvés.", my_tpk_dr.length());
	//download tpk des dr
	numeric p=1;
	if my_tpk_dr.length()>0 then
		do varying p=1 while p<=my_tpk_dr.length()
			string dr_current = my_tpk_dr(p);
			string file_tpk = 'tpk_'+dr_current+'.zip';
			if !syncfile(GET, my_file_serveur+file_tpk, PathTpk+ file_tpk) then
				inc(i);
			else
				if decompress(PathTpk+file_tpk, PathTpk)=default then
					errmsg("decompress non valide.");
					inc(i);
				endif;
			endif;
		enddo;
	else
		errmsg("Auncun DR n'a été téléchargé.");
		exit 0;
	endif;
	syncdisconnect();
	
	if i=0 then
		errmsg("Opération réussie.");
	else
		errmsg("L'opération ne s'est pas bien passée. Veuillez réesayer à nouveau.");
	endif;
end;

