function delete_quartier()
	numeric choice=0;
	choice=accept("Cette option est utilisée si vous n'arrivez pas à accèder à la liste des quartiers. Voulez-vous supprimer la liste des quartier ?",
			"Oui", "Non");
	if choice<>1 then
		exit 0;
	endif;
	if admin_acces(ID_ACTOR, 11) =0 then
		exit;
	endif;
	setfile(RGE_FICHE_QUARTIER_DICT, PathInput + 'quartiers_' + ID_ACTOR + '.csdb', create);
	errmsg("La liste des quartiers est supprimé avec succés. Veuillez vous approcher de votre chef d'équipe pour récupérer à nouveau les quartiers.");
end;
{
function update_data()
	numeric choice=0;
	choice = accept("Cette option est utilisée si l'enquêteur a synchronisé avec le chef d'équipe alors que ce dernier n'a pas reçu toutes les données. Etes-vous sûr de vouloir continuer ?",
						"Oui", "Non");
	if choice<>1 then
		exit;
	endif;
	init_dictionaries(2);
	//
	string filter=' ';
	if app<>'test' then
		if ID_ACTOR[1:3]<>'092' then
			filter='092';
		endif;
	endif;
	array alpha(50) array_result(5000, 4);
	array_result.clear();
	string nbr_query = "SELECT DISTINCT ext_codesup,ext_codequartier, ext_ID_EDIFICE, ext_login_enq "+
							"	FROM echantillon_verif_rec "+
							"	JOIN `level-1` ON `level-1`.`level-1-id` = echantillon_verif_rec.`level-1-id` "+
								maketext("WHERE ext_codesup='%s' and ext_login_ce='%s' and ext_login_enq='%s' and TRIM(ext_statut)<>'Non affecté' and ext_codecom not like '%s%' ", CODE_FORMATEUR, CODE_CE, ID_ACTOR, filter);
		
	numeric nb_query = sqlquery(CARTO_ECHANTILLON_DICT, array_result, nbr_query);
	// numeric m=1;
	numeric p=1;
	numeric k=0;
	if special(nb_query) then
		errmsg("Erreur sur la requete. Veuillez contacter le niveau central.");
		exit 0;
	endif;
	if nb_query>=1 then
		do varying k=1 while k<=nb_query
			string key_men_curr = strip(array_result(k, 1))+strip(array_result(k, 2))+strip(array_result(k, 3));
			if loadcase(CARTO_ECHANTILLON_DICT, key_men_curr) then
				EXT_INTEGRATION=randomin(0:1);
				// EXT_CTR_M1_AUTRE=randomin(0:1);
				// EXT_CTR_M4=randomin(0:1);
				writecase(CARTO_ECHANTILLON_DICT);
				inc(p);
			endif;
		enddo;
	endif;
	if p>0 then
		errmsg("Les données sont actualisées avec succés.");
	else
		errmsg("Les données ne sont pas actualisées.");
	endif;
	exit 1;
end;
}
function backup_agent()
	numeric choice0=0;
	choice0 = accept("Cette option est utilisée lorsqu'un agent a perdu sa tablette et que le chef d'équipe voudrait lui renvoyer ménages affectés à l'enquêteur concerné. Voulez-vous continuer ?",
				"Oui","Non");
	if choice0<>1 then
		exit 0;
	endif;
	init_dictionaries(2);
	numeric nb = countcases(RGE_FICHE_EDIFICE_DICT);
	if nb>0 then
		errmsg("Vous ne pouvez pas appliqué cette option si vous avez déjà collecté des ménages dans cette tablette.");
		if app<>'test' then
			exit 0;
		endif;
	endif;
	server_name = maketext("TB%s", ID_ACTOR);
	if getbluetoothname()<>maketext("TB%s", ID_ACTOR) then
		setbluetoothname(maketext("TB%s", ID_ACTOR));
	endif;
	init_dictionaries(2);
	{
	CLOSE(CARTO_PT_COLLECTE_DICT);
	setfile(CARTO_PT_COLLECTE_DICT, PathData+"point_collecte_"+ID_ACTOR+".csdb", create);
	}
	numeric k=1;
	numeric i=1;
	
	if !syncserver(bluetooth) then 
		errmsg("Impossible de se connecté avec le chef d'équipe %s", CODE_CE);
		syncdisconnect();
		exit 0;
	endif;
	syncdisconnect();
	//Recup point de collecte
	{
	list string my_pt_clted;
	my_pt_clted.clear();
	forcase CARTO_PT_COLLECTE_DICT(startswith, CODE_FORMATEUR) where PT_MLOGIN_ENQ=ID_ACTOR do
		my_pt_clted.add(key(CARTO_PT_COLLECTE_DICT));
	enddo;
	CLOSE(CARTO_PT_COLLECTE_DICT);
	do varying k=1 while k<=my_pt_clted.length()
		CLOSE(CARTO_PT_COLLECTE_DICT);
		if fileexist(PathData+"point_collecte_"+ my_pt_clted(k)[8:12]+"_"+ID_ACTOR+".csdb") then
			setfile(CARTO_PT_COLLECTE_DICT, PathData+"point_collecte_"+ my_pt_clted(k)[8:12]+"_"+ID_ACTOR+".csdb");
		else
			setfile(CARTO_PT_COLLECTE_DICT, PathData+"point_collecte_"+ my_pt_clted(k)[8:12]+"_"+ID_ACTOR+".csdb", create);
		endif;
		
		if !syncdata(GET, CARTO_PT_COLLECTE_DICT, my_pt_clted(k)) then
			errmsg("Les données des points de collecte ne sont pas récupérées.");
			inc(i);
			break;
		endif;
	enddo;
	}
	if i=0 then
		errmsg("Opération réussie.");
	else
		errmsg("L'opération ne s'est pas bie passée.");
	endif;
end;

function update_agent_serveur()
	numeric choice=0;
	choice = accept("Cette option est utilisée si vous n'arrivez pas synchroniser correctement avec votre chef d'équipe. Etes-vous sûr de vouloir continuer ?",
						"Oui", "Non");
	if choice<>1 then
		exit;
	endif;
	
	if admin_acces(ID_ACTOR, 20) =0 then
		exit;
	endif;
	
	init_dictionaries(1);
	if connect_to_serveur("serveur_data", app)=0 then
		exit 0;
	endif;
	close(RGE_USERS_DICT);
	// filedelete(PathParam + 'login_' + ID_ACTOR + '.csdb');
	if !filecopy(PathInputlogin + 'login_' + ID_ACTOR + '.csdb', PathParam + 'login_' + ID_ACTOR + '.csdb') then
		errmsg("Les informations de l'agent  ne sont pas copiées. Veuillez contacter le niveau central.");
		exit 0;
	endif;
	numeric i=0;
	CLOSE(RGE_USERS_DICT);
	filedelete(PathInputlogin + 'login_' + ID_ACTOR + '.csdb');
	setfile(RGE_USERS_DICT, PathInputlogin + 'login_' + ID_ACTOR + '.csdb', create);
	if  !syncdata(GET, RGE_USERS_DICT, ID_ACTOR) then
		inc(i);
	endif;
	
	if !loadcase(RGE_USERS_DICT, ID_ACTOR) then
		// filecopy(PathParam+ 'login_' + ID_ACTOR + '.csdb', PathInput  + 'login_' + ID_ACTOR + '.csdb');
		inc(i);		
	endif;
	if i=0 then
		loadcase(RGE_USERS_DICT, ID_ACTOR);
		LUNCH_AUTHORIZED=1;
		writecase(RGE_USERS_DICT);
		errmsg("Les informations de l'enquêteur sont actualisées avec succés.");
		exit 1;
	else
		filecopy(PathParam+ 'login_' + ID_ACTOR + '.csdb', PathInput  + 'login_' + ID_ACTOR + '.csdb');
		errmsg("L'opération ne s'est pas bien passé.");
		exit 0;
	endif;
end;

