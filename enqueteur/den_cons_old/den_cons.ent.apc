{ Application 'den_cons' logic file generated by CSPro }
PROC GLOBAL
string PathProg, PathInput,
		PathPrep, PathInputlogin, PathResources;
alpha(100) ReadString;
string app="";
string key_qrt, new_adresse, type_obs, key_cons;
string app_current;

function add_men(string actor, string name_actor, string actor_ce, string name_actor_ce,string actor_form,string name_actor_form,  string type, numeric ctr)
	string cons_current = loadsetting("key_cons_current");
	// errmsg("quartier_current : %s", quartier_current);
	numeric choice = 0;
	if ctr=1 then
		choice = accept("Voulez vous ajouter un ménage ?",
								"Oui",
								"Non");
		if choice<>1 then
			exit 0;
		endif;
	endif;
	if loadcase(CARTO_FICHE_QUARTIER_DICT, cons_current) then
		errmsg("Les informations du quartiers sont introuvables. Veuillez contacter le niveau central.");
		exit 0;
	endif;
	
	numeric nb=0;
	nb=countcases(RGE_FICHE_UNITE_DICT(startswith, cons_current) where UNITE_AJOUT=8);
	CLEAR(RGE_FICHE_UNITE_DICT);
	UNITE_CODESUP=cons_current[1:7];
	UNITE_ID_DR=cons_current[8:12];
	UNITE_ID_LACALITE=cons_current[20:13];
	UNITE_ID_EDIFICE=cons_current[33:5];
	UNITE_ID_NUM_UNITE=uuid()[1:3];
	
	UNITE_REGION=cons_current[20:2];
	UNITE_DEPARTEMENT=cons_current[20:3];
	UNITE_CVA=cons_current[20:6];
	UNITE_COMMUNE=cons_current[20:8];
	// UNITE_DR_2022=QRT_DR_2022;
	UNITE_ID_NUM_UNITE_LIBELLE=maketext("N%02s", edit("99", nb+1));
	
	// UNITE_NOM_CM="Nom CM";
	// UNITE_ADRESSE_MENAGE="Nom adresse";
	// UNITE_NUM_TEL=777777777;
	UNITE_STATUT=0;
	UNITE_CODE_AR=actor;
	UNITE_NOM_AR=strip(name_actor);
	UNITE_CODE_CE=actor_ce;
	UNITE_NOM_CE=strip(name_actor_ce);
	UNITE_CODE_SUP=actor_form;
	UNITE_NOM_SUP=strip(name_actor_form);
	UNITE_AJOUT=8;
	string id_men = UNITE_CODESUP+UNITE_ID_DR+UNITE_ID_LACALITE+UNITE_ID_EDIFICE+UNITE_ID_NUM_UNITE;
	//controle de l'existance pour les coptage directe
	if loadcase(RGE_FICHE_UNITE_DICT,id_men) then
		errmsg("Veuillez refaire l'opération.");
		clear(RGE_FICHE_UNITE_DICT);
		exit 0;
	endif;
	
	writecase(RGE_FICHE_UNITE_DICT);
	errmsg("Le ménage est ajouté avec succés.");
	exit 1;
end;

function view_men()
	numeric nb_men=countcases(RGE_FICHE_UNITE_DICT(startswith, key_cons));
	if nb_men=0 then
		exit 0;
	endif;
	
	list string index_remplacant_a_integrer_array;
	array string  UNITE_array(100, 5);
	UNITE_array.clear();
	string id_ind, name_ind;
	numeric i=1;
	forcase RGE_FICHE_UNITE_DICT(startswith, key_cons) do
		index_remplacant_a_integrer_array.add(key(RGE_FICHE_UNITE_DICT));
		// UNITE_array(i, 1) = UNITE_ID_NUM_MEN;
		if UNITE_ID_NUM_UNITE_LIBELLE="" then
			UNITE_array(i, 1) = UNITE_ID_NUM_UNITE;
		else
			UNITE_array(i, 1) = strip(UNITE_ID_NUM_UNITE_LIBELLE);
		endif;
		UNITE_array(i, 2) = strip(UNITE_NOM_UNITE);
		if UNITE_ADRESSE_UNITE="" then
			UNITE_array(i, 3) = "NEANT";
		else
			UNITE_array(i, 3) = strip(UNITE_ADRESSE_UNITE);
		endif;
		UNITE_array(i, 4) = edit("ZZZZZZZZZ", UNITE_NUM_TEL_UNITE);
		// UNITE_array(i, 5) = "Non entamé";
		if special(UNITE_STATUT) then
			UNITE_array(i, 5) = "Non entamé";
		else
			UNITE_array(i, 5) = getvaluelabel(UNITE_STATUT);
		endif;
		inc(i);
	endfor;

	if index_remplacant_a_integrer_array.length()=0 then
		exit 0;
	endif;
	numeric IndSelection = showarray(maketext("Cette concession/Infrastructure contenait %02d ménages. Veuillez confirmer avec le répondant sur l'inexistene des ménages suivants dans cette concession/infrastructure ", nb_men), UNITE_array, 
		title("Num men","Nom CM",  "Adresse", "Tel",  "Statut"));
		exit 0;
end;

	
PROC FICHE_CONS_DICT_FF

